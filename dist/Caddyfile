{
    frankenphp {
        # El binario no incluye php.ini en Linux/macOS: sin esto PHP usa sus valores por defecto
        # (2M por fichero, 8M por envío, 128M de memoria, display_errors activado). Con display_errors
        # activado, el aviso de «POST demasiado grande» se escribe antes que las cabeceras, la sesión
        # falla y el navegador recibe una respuesta rota (pantalla en blanco).
        php_ini display_errors Off
        php_ini log_errors On
        php_ini upload_max_filesize 16M
        php_ini post_max_size 64M
        php_ini max_file_uploads 50
        php_ini memory_limit 256M
    }
    admin off

    log {
        output stderr
        level WARN
    }
}

# SERVER_ADDR se inyecta desde el script de arranque, p.ej. ":8080"
{$SERVER_ADDR} {
    root * {$DOCUMENT_ROOT}

    encode gzip

    # Cabeceras de seguridad de base y Content-Security-Policy.
    # La aplicación no carga nada de terceros (Quill, Tom Select y los controladores
    # Stimulus se sirven desde /assets/), así que todo se limita al propio origen.
    # 'unsafe-inline' en script-src/style-src sigue haciendo falta: hay <script> y
    # manejadores on*="" en línea y atributos style="". Con ello no se frena un XSS
    # que inyecte script en línea (las plantillas escapan todo y no hay hallazgos),
    # pero sí se impide cargar scripts de otro origen, enviar datos a otro dominio
    # (connect/img/form-action), incrustar la aplicación (frame-ancestors) y
    # plugins (object-src), y cambiar <base>. Si algún día se pasa a nonces, quitar
    # 'unsafe-inline'. Misma política en docker/Caddyfile y public/.htaccess.
    header {
        Content-Security-Policy   "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "geolocation=(), camera=(), microphone=(), payment=()"
        -Server
    }

    # Caché de ficheros estáticos. public/assets/ lo genera AssetMapper con el
    # hash del contenido en el nombre de fichero, así que es seguro cachear
    # "para siempre"; public/static/ (favicons, logo, fuentes) no lleva hash,
    # así que usa una duración moderada en vez de "immutable".
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    @static path /static/*
    header @static Cache-Control "public, max-age=2592000"

    # FrankenPHP gestiona tanto PHP como ficheros estáticos
    php_server
}
