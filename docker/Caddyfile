{
    frankenphp
    admin off

    log {
        output stderr
        level WARN
    }
}

{$SERVER_NAME} {
    root * /app/public

    encode zstd br gzip

    # Cabeceras de seguridad de base y Content-Security-Policy.
    # La aplicación no carga nada de terceros (Quill, Tom Select y los controladores
    # Stimulus se sirven desde /assets/), así que todo se limita al propio origen.
    # 'unsafe-inline' en script-src/style-src sigue haciendo falta: hay <script> y
    # manejadores on*="" en línea y atributos style="". Con ello no se frena un XSS
    # que inyecte script en línea (las plantillas escapan todo y no hay hallazgos),
    # pero sí se impide cargar scripts de otro origen, enviar datos a otro dominio
    # (connect/img/form-action), incrustar la aplicación (frame-ancestors) y
    # plugins (object-src), y cambiar <base>. Si algún día se pasa a nonces, quitar
    # 'unsafe-inline'. Misma política en dist/Caddyfile y public/.htaccess.
    # `data:` en script-src es imprescindible: AssetMapper convierte los `import 'x.css'` del
    # importmap en módulos `data:application/javascript,…`; sin él falla el import y no se carga
    # NADA del JavaScript de la aplicación (verificado en la imagen Docker). Con nonces habría
    # que revisar también este origen.
    header {
        Content-Security-Policy   "default-src 'self'; script-src 'self' 'unsafe-inline' data:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options    "nosniff"
        X-Frame-Options           "DENY"
        Referrer-Policy           "strict-origin-when-cross-origin"
        Permissions-Policy        "geolocation=(), camera=(), microphone=(), payment=()"
        -Server
    }

    # Caché de ficheros estáticos. public/assets/ lo genera AssetMapper con el
    # hash del contenido en el nombre de fichero, así que es seguro cachear
    # "para siempre"; public/static/ (favicons, logo, fuentes) no lleva hash,
    # así que usa una duración moderada en vez de "immutable".
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"
    @static path /static/*
    header @static Cache-Control "public, max-age=2592000"

    # FrankenPHP gestiona tanto PHP como ficheros estáticos
    php_server
}
