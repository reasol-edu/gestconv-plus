{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'issue.number'|trans({'%number%': issue.number}, 'admin') }} · {{ app_name }}{% endblock %}

{% block content %}
{% set inputClass = 'block w-full rounded-xl border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-sm text-gray-900 focus:border-forest-500 focus:bg-white focus:outline-none focus:ring-3 focus:ring-forest-500/20 transition-colors' %}
{% set id = issue.id.toRfc4122 %}
{% set overdue = issue.isOverdue(today) %}
<div class="px-6 py-8 max-w-5xl mx-auto space-y-6">

    <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 flex-wrap">
            {% include 'components/_breadcrumb_home.html.twig' %}
            <a href="{{ path('app_issues_index') }}" class="hover:text-forest-600 transition-colors">{{ 'issue.title'|trans({}, 'admin') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <h1 class="text-2xl font-bold text-gray-900">{{ 'issue.number'|trans({'%number%': issue.number}, 'admin') }}</h1>
            {% include 'issue/_status_badge.html.twig' with {status: issue.status} only %}
            {% include 'issue/_priority_badge.html.twig' with {priority: issue.priority} only %}
            {% if overdue %}
                <span class="inline-flex items-center gap-1 rounded-full border border-red-200 bg-red-50 px-2.5 py-0.5 text-xs font-semibold text-red-700">
                    {{ ux_icon('heroicons:clock', {class: 'h-3.5 w-3.5'}) }}{{ 'issue.overdue'|trans({}, 'admin') }}
                </span>
            {% endif %}
        </div>
        <p class="mt-1 text-sm text-gray-500">{{ issue.type.path }}</p>
    </div>

    {# ── Fila superior: los datos y, para quien la gestiona, el panel de gestión ───────────────────── #}
    <div class="grid grid-cols-1 items-start gap-6 {{ canManage ? 'lg:grid-cols-2' : '' }}">
        <section class="rounded-2xl border border-gray-200 bg-white shadow-xs p-5" aria-labelledby="issue-data-title">
            <h2 id="issue-data-title" class="sr-only">{{ 'issue.data'|trans({}, 'admin') }}</h2>
            <dl class="space-y-3 text-sm">
                <div>
                    <dt class="text-xs font-semibold uppercase tracking-wide text-gray-400">{{ 'issue.field.reporter'|trans({}, 'admin') }}</dt>
                    <dd class="mt-0.5 text-gray-900">{{ issue.reporter.name.full() }}</dd>
                </div>
                <div>
                    <dt class="text-xs font-semibold uppercase tracking-wide text-gray-400">{{ 'issue.field.created_at'|trans({}, 'admin') }}</dt>
                    <dd class="mt-0.5 text-gray-900">{{ issue.createdAt|date('format.datetime'|trans) }}</dd>
                </div>
                {% if issue.booking %}
                    <div>
                        <dt class="text-xs font-semibold uppercase tracking-wide text-gray-400">{{ 'issue.field.booking'|trans({}, 'admin') }}</dt>
                        <dd class="mt-0.5 text-gray-900">
                            {% if is_granted('resource_booking.edit', issue.booking) %}
                                <a href="{{ path('app_bookings_show', {id: issue.booking.id}) }}" class="font-medium text-forest-700 hover:underline">{{ issue.booking.resource.name }}</a>
                            {% else %}
                                {{ issue.booking.resource.name }}
                            {% endif %}
                            · {{ issue.booking.date|date('format.date'|trans) }}
                        </dd>
                    </div>
                {% elseif issue.location %}
                    <div>
                        <dt class="text-xs font-semibold uppercase tracking-wide text-gray-400">{{ 'issue.field.location'|trans({}, 'admin') }}</dt>
                        <dd class="mt-0.5 text-gray-900">{{ issue.location.name }} <span class="text-xs text-gray-400">({{ issue.location.category.name }})</span></dd>
                    </div>
                {% endif %}
                {% if issue.maxDue or issue.recommendedDue %}
                    <div>
                        <dt class="text-xs font-semibold uppercase tracking-wide text-gray-400">{{ 'issue.field.deadlines'|trans({}, 'admin') }}</dt>
                        <dd class="mt-0.5 space-y-0.5 text-gray-900">
                            {% if issue.recommendedDue %}<p>{{ 'issue.deadline.recommended'|trans({'%date%': issue.recommendedDue|date('format.date'|trans)}, 'admin') }}</p>{% endif %}
                            {% if issue.maxDue %}<p class="{{ overdue ? 'font-semibold text-red-700' : '' }}">{{ 'issue.deadline.max'|trans({'%date%': issue.maxDue|date('format.date'|trans)}, 'admin') }}</p>{% endif %}
                        </dd>
                    </div>
                {% endif %}
                {% if issue.closedAt %}
                    <div>
                        <dt class="text-xs font-semibold uppercase tracking-wide text-gray-400">{{ 'issue.field.closed_at'|trans({}, 'admin') }}</dt>
                        <dd class="mt-0.5 text-gray-900">{{ issue.closedAt|date('format.datetime'|trans) }}</dd>
                    </div>
                {% endif %}
                {% if issue.duplicateOf %}
                    <div>
                        <dt class="text-xs font-semibold uppercase tracking-wide text-gray-400">{{ 'issue.duplicate_of'|trans({}, 'admin') }}</dt>
                        <dd class="mt-0.5"><a href="{{ path('app_issues_show', {id: issue.duplicateOf.id}) }}" class="font-medium text-forest-700 hover:underline">{{ 'issue.number'|trans({'%number%': issue.duplicateOf.number}, 'admin') }}</a></dd>
                    </div>
                {% endif %}
            </dl>
        </section>

        {% if canManage %}
            <section class="rounded-2xl border border-gray-200 bg-white shadow-xs p-5" aria-labelledby="issue-manage-title">
                <h2 id="issue-manage-title" class="text-sm font-semibold text-gray-900 mb-3">{{ 'issue.manage.title'|trans({}, 'admin') }}</h2>
                <form method="post" action="{{ path('app_issues_manage', {id: id}) }}" class="space-y-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('manage_issue_' ~ id) }}">
                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                        <div>
                            <label for="manage-priority" class="block text-xs font-medium text-gray-500 mb-1">{{ 'issue.field.priority'|trans({}, 'admin') }}</label>
                            <select id="manage-priority" name="priority" class="{{ inputClass }}">
                                <option value="">{{ 'issue.priority.none'|trans({}, 'admin') }}</option>
                                {% for priority in priorities %}
                                    <option value="{{ priority.id.toRfc4122 }}" {{ issue.priority and issue.priority.id.equals(priority.id) ? 'selected' : '' }}>{{ priority.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div>
                            <label for="manage-status" class="block text-xs font-medium text-gray-500 mb-1">{{ 'issue.field.status'|trans({}, 'admin') }}</label>
                            <select id="manage-status" name="status" class="{{ inputClass }}">
                                {% for status in ['open', 'in_progress', 'solved', 'not_applicable', 'duplicate'] %}
                                    {# «En proceso» exige prioridad: sin ella no se ofrece (se habilita al elegir una). #}
                                    <option value="{{ status }}" {{ issue.status.value == status ? 'selected' : '' }}
                                            {% if status == 'in_progress' %}data-needs-priority="1"{% if issue.priority is null %} disabled{% endif %}{% endif %}>{{ ('issue.status.' ~ status)|trans({}, 'admin') }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                    <p class="text-xs text-gray-500">{{ 'issue.manage.status_help'|trans({}, 'admin') }}</p>
                    <div>
                        <label for="manage-duplicate" class="block text-xs font-medium text-gray-500 mb-1">{{ 'issue.duplicate_of'|trans({}, 'admin') }}</label>
                        {% include 'issue/_duplicate_select.html.twig' with {id: 'manage-duplicate', candidates: candidates, current: issue.duplicateOf} only %}
                    </div>
                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                        <div>
                            <label for="manage-type" class="block text-xs font-medium text-gray-500 mb-1">{{ 'issue.field.type'|trans({}, 'admin') }}</label>
                            <select id="manage-type" name="type" class="{{ inputClass }}">
                                {% for type in types %}
                                    <option value="{{ type.id.toRfc4122 }}" {{ issue.type.id.equals(type.id) ? 'selected' : '' }}>{{ type.path }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        {% if not issue.booking %}
                            <div>
                                <label for="manage-location" class="block text-xs font-medium text-gray-500 mb-1">{{ 'issue.field.location'|trans({}, 'admin') }}</label>
                                <select id="manage-location" name="location" class="{{ inputClass }}">
                                    <option value="">—</option>
                                    {% set lastCategory = null %}
                                    {% for location in locations %}
                                        {% if location.category.id.toRfc4122 != lastCategory %}
                                            {% if lastCategory is not null %}</optgroup>{% endif %}
                                            <optgroup label="{{ location.category.name }}">
                                            {% set lastCategory = location.category.id.toRfc4122 %}
                                        {% endif %}
                                        <option value="{{ location.id.toRfc4122 }}" {{ issue.location and issue.location.id.equals(location.id) ? 'selected' : '' }}>{{ location.name }}</option>
                                        {% if loop.last %}</optgroup>{% endif %}
                                    {% endfor %}
                                </select>
                            </div>
                        {% endif %}
                    </div>
                    <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-forest-600 px-4 py-2 text-sm font-semibold text-white hover:bg-forest-700 transition-colors shadow-xs">
                        {{ ux_icon('heroicons:check', {class: 'h-4 w-4'}) }}{{ 'issue.manage.save'|trans({}, 'admin') }}
                    </button>
                </form>

                {% if canDelete %}
                    <form method="post" action="{{ path('app_issues_delete', {id: id}) }}" class="js-confirm-form mt-3 border-t border-gray-100 pt-3"
                          data-confirm="{{ 'issue.delete_confirm'|trans({'%number%': issue.number}, 'admin')|e('html_attr') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_issue_' ~ id) }}">
                        <button type="submit" class="js-confirm-trigger inline-flex w-full items-center justify-center gap-2 rounded-xl border border-red-200 bg-white px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-50 transition-colors">
                            {{ ux_icon('heroicons:trash', {class: 'h-4 w-4'}) }}{{ 'issue.delete'|trans({}, 'admin') }}
                        </button>
                    </form>
                {% endif %}
            </section>
        {% endif %}
    </div>

    <div class="space-y-6">

            <section class="rounded-2xl border border-gray-200 bg-white shadow-xs p-6" aria-labelledby="issue-description-title">
                <h2 id="issue-description-title" class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-2">{{ 'issue.field.description'|trans({}, 'admin') }}</h2>
                <div class="prose prose-sm max-w-none text-gray-700">{{ issue.description|sanitize_html('app.rich_text') }}</div>

                {% if canEdit %}
                    <details class="mt-4 border-t border-gray-100 pt-4">
                        <summary class="cursor-pointer text-sm font-medium text-forest-700 hover:text-forest-800">{{ 'issue.edit_description'|trans({}, 'admin') }}</summary>
                        <form method="post" action="{{ path('app_issues_edit', {id: id}) }}" class="mt-3 space-y-3">
                            <input type="hidden" name="_token" value="{{ csrf_token('edit_issue_' ~ id) }}">
                            <twig:Form:RichEditor id="description" name="description" label="{{ 'issue.field.description'|trans({}, 'admin') }}" value="{{ issue.description }}" :required="true" />
                            <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-forest-600 px-4 py-2 text-sm font-semibold text-white hover:bg-forest-700 transition-colors shadow-xs">
                                {{ ux_icon('heroicons:check', {class: 'h-4 w-4'}) }}{{ 'issue.save'|trans({}, 'admin') }}
                            </button>
                        </form>
                    </details>
                {% endif %}
            </section>

            {# ── Adjuntos ────────────────────────────────────────────────── #}
            <section class="rounded-2xl border border-gray-200 bg-white shadow-xs p-6 space-y-4" aria-labelledby="issue-attachments-title">
                <h2 id="issue-attachments-title" class="text-xs font-semibold uppercase tracking-wide text-gray-400">{{ 'issue.attachments.title'|trans({}, 'admin') }} ({{ issue.attachments|length }})</h2>

                {% if issue.attachments is empty %}
                    <p class="text-sm text-gray-500">{{ 'issue.attachments.empty'|trans({}, 'admin') }}</p>
                {% else %}
                    {% set images = issue.attachments|filter(a => a.hasThumbnail) %}
                    {% set files = issue.attachments|filter(a => not a.hasThumbnail) %}
                    {% if images is not empty %}
                        <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3">
                            {% for attachment in images %}
                                <li class="group relative overflow-hidden rounded-xl border border-gray-200 bg-gray-50">
                                    <a href="{{ path('app_issues_attachment', {id: id, attachmentId: attachment.id, ver: 1}) }}" target="_blank" rel="noopener" title="{{ attachment.filename }}">
                                        <img src="{{ path('app_issues_attachment', {id: id, attachmentId: attachment.id, miniatura: 1}) }}" alt="{{ attachment.filename }}" loading="lazy"
                                             class="h-32 w-full object-cover">
                                    </a>
                                    <p class="truncate px-2 py-1 text-xs text-gray-600">{{ attachment.filename }}</p>
                                    {% if canManage or (attachment.uploadedBy and attachment.uploadedBy.id.equals(app.user.id) and issue.open) %}
                                        <form method="post" action="{{ path('app_issues_attachment_delete', {id: id, attachmentId: attachment.id}) }}" class="js-confirm-form absolute right-1.5 top-1.5"
                                              data-confirm="{{ 'issue.attachments.delete_confirm'|trans({}, 'admin')|e('html_attr') }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_issue_attachment_' ~ id) }}">
                                            <button type="submit" class="js-confirm-trigger rounded-full bg-white/90 p-1 text-red-600 shadow hover:bg-white" aria-label="{{ 'issue.attachments.delete'|trans({}, 'admin') }}">
                                                {{ ux_icon('heroicons:trash', {class: 'h-3.5 w-3.5'}) }}
                                            </button>
                                        </form>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                    {% if files is not empty %}
                        <ul class="divide-y divide-gray-100 rounded-xl border border-gray-200">
                            {% for attachment in files %}
                                <li class="flex items-center gap-3 px-3.5 py-2.5">
                                    {{ ux_icon('heroicons:paper-clip', {class: 'h-4 w-4 shrink-0 text-gray-400'}) }}
                                    <a href="{{ path('app_issues_attachment', {id: id, attachmentId: attachment.id}) }}" class="min-w-0 flex-1 truncate text-sm font-medium text-forest-700 hover:underline">{{ attachment.filename }}</a>
                                    <span class="shrink-0 text-xs text-gray-400">{{ upload_limits().formatSize(attachment.size) }}</span>
                                    {% if canManage or (attachment.uploadedBy and attachment.uploadedBy.id.equals(app.user.id) and issue.open) %}
                                        <form method="post" action="{{ path('app_issues_attachment_delete', {id: id, attachmentId: attachment.id}) }}" class="js-confirm-form"
                                              data-confirm="{{ 'issue.attachments.delete_confirm'|trans({}, 'admin')|e('html_attr') }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_issue_attachment_' ~ id) }}">
                                            <button type="submit" class="js-confirm-trigger rounded-lg p-1 text-red-600 hover:bg-red-50" aria-label="{{ 'issue.attachments.delete'|trans({}, 'admin') }}">
                                                {{ ux_icon('heroicons:trash', {class: 'h-3.5 w-3.5'}) }}
                                            </button>
                                        </form>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}
                {% endif %}

                <form method="post" action="{{ path('app_issues_attach', {id: id}) }}" enctype="multipart/form-data" class="space-y-3 border-t border-gray-100 pt-4">
                    <input type="hidden" name="_token" value="{{ csrf_token('attach_issue_' ~ id) }}">
                    <twig:Form:AttachmentDropzone id="attachments" name="attachments[]" label="{{ 'issue.attachments.add'|trans({}, 'admin') }}"
                        accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.odt,.ods,.odp,.txt" help="{{ 'issue.field.attachments_help'|trans({}, 'admin') }}" />
                    <button type="submit" class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors">
                        {{ ux_icon('heroicons:arrow-up-tray', {class: 'h-4 w-4'}) }}{{ 'issue.attachments.upload'|trans({}, 'admin') }}
                    </button>
                </form>
            </section>

            {# ── Observaciones ───────────────────────────────────────────── #}
            <section class="rounded-2xl border border-gray-200 bg-white shadow-xs p-6 space-y-4" aria-labelledby="issue-observations-title">
                <h2 id="issue-observations-title" class="text-xs font-semibold uppercase tracking-wide text-gray-400">{{ 'issue.observations.title'|trans({}, 'admin') }} ({{ issue.observations|length }})</h2>

                {% if issue.observations is empty %}
                    <p class="text-sm text-gray-500">{{ 'issue.observations.empty'|trans({}, 'admin') }}</p>
                {% else %}
                    <ol class="space-y-3">
                        {% for observation in issue.observations %}
                            <li class="rounded-xl border border-gray-200 bg-gray-50 px-4 py-3">
                                <p class="flex flex-wrap items-center gap-2 text-xs text-gray-500">
                                    <span class="font-semibold text-gray-700">{{ observation.author.name.full() }}</span>
                                    <span>{{ observation.createdAt|date('format.datetime'|trans) }}</span>
                                </p>
                                <p class="mt-1 whitespace-pre-line text-sm text-gray-800">{{ observation.content }}</p>
                            </li>
                        {% endfor %}
                    </ol>
                {% endif %}

                <form method="post" action="{{ path('app_issues_observe', {id: id}) }}" class="space-y-3 border-t border-gray-100 pt-4">
                    <input type="hidden" name="_token" value="{{ csrf_token('observe_issue_' ~ id) }}">
                    <div>
                        <label for="observation-content" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'issue.observations.add'|trans({}, 'admin') }}</label>
                        <textarea id="observation-content" name="content" rows="3" required maxlength="5000" class="{{ inputClass }}"></textarea>
                    </div>
                    {% if canManage %}
                        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                            <div>
                                <label for="observation-status" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'issue.observations.change_status'|trans({}, 'admin') }}</label>
                                <select id="observation-status" name="status" class="{{ inputClass }}">
                                    <option value="">{{ 'issue.observations.keep_status'|trans({}, 'admin') }}</option>
                                    {% for status in ['in_progress', 'solved', 'not_applicable', 'duplicate', 'open'] %}
                                        {% if status != issue.status.value %}
                                            {# «Poner en proceso» exige prioridad: sin ella no se ofrece. #}
                                            <option value="{{ status }}" {{ status == 'in_progress' and issue.priority is null ? 'disabled' : '' }}>{{ ('issue.status.action.' ~ status)|trans({}, 'admin') }}</option>
                                        {% endif %}
                                    {% endfor %}
                                </select>
                            </div>
                            <div>
                                <label for="observation-duplicate" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'issue.duplicate_of'|trans({}, 'admin') }}</label>
                                {% include 'issue/_duplicate_select.html.twig' with {id: 'observation-duplicate', candidates: candidates, current: null} only %}
                                <p class="mt-1 text-xs text-gray-500">{{ 'issue.duplicate_help'|trans({}, 'admin') }}</p>
                            </div>
                        </div>
                    {% endif %}
                    <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-forest-600 px-4 py-2 text-sm font-semibold text-white hover:bg-forest-700 transition-colors shadow-xs">
                        {{ ux_icon('heroicons:chat-bubble-left-ellipsis', {class: 'h-4 w-4'}) }}{{ 'issue.observations.submit'|trans({}, 'admin') }}
                    </button>
                </form>
            </section>

            {# ── Historial ───────────────────────────────────────────────── #}
            <section class="rounded-2xl border border-gray-200 bg-white shadow-xs p-6" aria-labelledby="issue-history-title">
                <details>
                    <summary id="issue-history-title" class="cursor-pointer text-xs font-semibold uppercase tracking-wide text-gray-400">{{ 'issue.history.title'|trans({}, 'admin') }} ({{ issue.changes|length }})</summary>
                    <ol class="mt-3 space-y-2 text-sm">
                        {% for change in issue.changes|reverse %}
                            <li class="rounded-lg border border-gray-100 px-3 py-2">
                                <p class="flex flex-wrap items-center gap-2 text-xs text-gray-500">
                                    <span class="font-semibold text-gray-700">{{ change.author ? change.author.name.full() : '—' }}</span>
                                    <span>{{ change.createdAt|date('format.datetime'|trans) }}</span>
                                    <span class="rounded-md bg-gray-100 px-1.5 py-0.5 font-medium text-gray-600">{{ ('issue.history.field.' ~ change.field)|trans({}, 'admin') }}</span>
                                </p>
                                {% if change.field == 'description' %}
                                    <details class="mt-1">
                                        <summary class="cursor-pointer text-xs text-forest-700">{{ 'issue.history.show_values'|trans({}, 'admin') }}</summary>
                                        <div class="mt-1 grid gap-2 sm:grid-cols-2">
                                            <div class="rounded-md bg-red-50/60 p-2 text-xs"><div class="prose prose-sm max-w-none">{{ (change.oldValue ?? '')|sanitize_html('app.rich_text') }}</div></div>
                                            <div class="rounded-md bg-forest-50/60 p-2 text-xs"><div class="prose prose-sm max-w-none">{{ (change.newValue ?? '')|sanitize_html('app.rich_text') }}</div></div>
                                        </div>
                                    </details>
                                {% else %}
                                    {% set old = change.oldValue is null ? '—' : (change.field == 'status' ? ('issue.status.' ~ change.oldValue)|trans({}, 'admin') : change.oldValue) %}
                                    {% set new = change.newValue is null ? '—' : (change.field == 'status' ? ('issue.status.' ~ change.newValue)|trans({}, 'admin') : change.newValue) %}
                                    <p class="mt-1 text-gray-700">
                                        {% if change.field == 'created' %}
                                            {{ 'issue.history.created'|trans({'%type%': new}, 'admin') }}
                                        {% else %}
                                            <span class="text-gray-500 line-through">{{ old }}</span> → <span class="font-medium">{{ new }}</span>
                                        {% endif %}
                                    </p>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ol>
                </details>
            </section>
        </div>


</div>
{% endblock %}

{% block javascripts %}{{ parent() }}
{% if canManage %}
<script type="module">
import TomSelect from 'tom-select';

// Original de una duplicada: desplegable con buscador por número, tipo o texto (sobre <body> para que no lo recorte la tarjeta).
for (const el of document.querySelectorAll('select.ts-duplicate')) {
    new TomSelect(el, {
        create:           false,
        maxOptions:       200,
        dropdownParent:   'body',
        placeholder:      el.dataset.placeholder ?? '',
        allowEmptyOption: true,
        render: {
            no_results: () => `<div class="no-results px-3 py-2 text-sm">${el.dataset.noResults ?? ''}</div>`,
        },
    });
}

// «En proceso» solo se ofrece con prioridad: al elegir una en el panel de gestión se habilita, y al quitarla se retira.
const priority = document.getElementById('manage-priority');
const status   = document.getElementById('manage-status');
if (priority && status) {
    const sync = () => {
        for (const option of status.querySelectorAll('option[data-needs-priority]')) {
            option.disabled = priority.value === '';
        }
        if (status.selectedOptions[0]?.disabled) {
            status.value = 'open';
        }
    };
    priority.addEventListener('change', sync);
    sync();
}
</script>
{% endif %}
{% endblock %}
