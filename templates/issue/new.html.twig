{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'issue.new.title'|trans({}, 'admin') }} · {{ app_name }}{% endblock %}

{% block content %}
{% set inputClass = 'block w-full rounded-xl border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-sm text-gray-900 focus:border-forest-500 focus:bg-white focus:outline-none focus:ring-3 focus:ring-forest-500/20 transition-colors' %}
<div class="px-6 py-8 max-w-3xl mx-auto space-y-6">

    <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 flex-wrap">
            {% include 'components/_breadcrumb_home.html.twig' %}
            <a href="{{ path('app_issues_index') }}" class="hover:text-forest-600 transition-colors">{{ 'issue.title'|trans({}, 'admin') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ 'issue.new.title'|trans({}, 'admin') }}</h1>
        <p class="mt-1 text-sm text-gray-500">{{ 'issue.new.intro'|trans({}, 'admin') }}</p>
    </div>

    <form method="post" enctype="multipart/form-data" class="space-y-6" data-controller="form-submit unsaved-changes">
        <input type="hidden" name="_token" value="{{ csrf_token('new_issue') }}">
        {% if booking %}<input type="hidden" name="booking" value="{{ booking.id.toRfc4122 }}">{% endif %}

        <div class="rounded-2xl border border-gray-200 bg-white shadow-xs p-6 space-y-5">

            {% if booking %}
                <div class="flex items-start gap-3 rounded-xl border border-forest-200 bg-forest-50 px-4 py-3 text-sm text-forest-900">
                    {{ ux_icon('heroicons:rectangle-stack', {class: 'h-5 w-5 shrink-0 text-forest-600'}) }}
                    <p>
                        {{ 'issue.new.from_booking'|trans({
                            '%resource%': booking.resource.name,
                            '%date%': booking.date|date('format.date'|trans),
                        }, 'admin') }}
                    </p>
                </div>
            {% endif %}

            <div>
                <label for="type" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'issue.field.type'|trans({}, 'admin') }} <span class="text-red-500" aria-hidden="true">*</span></label>
                <select id="type" name="type" required class="w-full text-sm ts-local"
                        data-placeholder="{{ 'issue.field.type_placeholder'|trans({}, 'admin')|e('html_attr') }}"
                        data-no-results="{{ 'tom_select.no_results'|trans({}, 'admin')|e('html_attr') }}">
                    <option value="">{{ 'issue.field.type_placeholder'|trans({}, 'admin') }}</option>
                    {% for type in types %}
                        <option value="{{ type.id.toRfc4122 }}" {{ values.type == type.id.toRfc4122 ? 'selected' : '' }}>{{ type.path }}</option>
                    {% endfor %}
                </select>
                {% if errors.type is defined %}<p class="mt-1.5 text-sm text-red-600" role="alert">{{ errors.type|trans({}, 'admin') }}</p>{% endif %}
                {% if types is empty %}<p class="mt-1.5 text-sm text-amber-700">{{ 'issue.new.no_types'|trans({}, 'admin') }}</p>{% endif %}
                <p class="mt-1.5 text-xs text-gray-500">{{ 'issue.field.type_help'|trans({}, 'admin') }}</p>
            </div>

            {% if not booking %}
                <div>
                    <label for="location" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'issue.field.location'|trans({}, 'admin') }}</label>
                    <select id="location" name="location" class="w-full text-sm ts-local"
                            data-placeholder="{{ 'issue.field.location_placeholder'|trans({}, 'admin')|e('html_attr') }}"
                            data-no-results="{{ 'tom_select.no_results'|trans({}, 'admin')|e('html_attr') }}">
                        <option value="">{{ 'issue.field.location_placeholder'|trans({}, 'admin') }}</option>
                        {% set lastCategory = null %}
                        {% for location in locations %}
                            {% if location.category.id.toRfc4122 != lastCategory %}
                                {% if lastCategory is not null %}</optgroup>{% endif %}
                                <optgroup label="{{ location.category.name }}">
                                {% set lastCategory = location.category.id.toRfc4122 %}
                            {% endif %}
                            <option value="{{ location.id.toRfc4122 }}" {{ values.location == location.id.toRfc4122 ? 'selected' : '' }}>{{ location.name }}</option>
                            {% if loop.last %}</optgroup>{% endif %}
                        {% endfor %}
                    </select>
                    <p class="mt-1.5 text-xs text-gray-500">{{ 'issue.field.location_help'|trans({}, 'admin') }}</p>
                </div>
            {% endif %}

            <twig:Form:RichEditor
                id="description"
                name="description"
                label="{{ 'issue.field.description'|trans({}, 'admin') }}"
                value="{{ values.description }}"
                help="{{ 'issue.field.description_help'|trans({}, 'admin') }}"
                :required="true"
                :error="errors.description is defined ? (errors.description|trans({}, 'admin')) : null"
            />

            <twig:Form:AttachmentDropzone
                id="attachments"
                name="attachments[]"
                label="{{ 'issue.field.attachments'|trans({}, 'admin') }}"
                accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.odt,.ods,.odp,.txt"
                help="{{ 'issue.field.attachments_help'|trans({}, 'admin') }}"
                :error="errors.attachments ?? null"
            />
        </div>

        <div class="flex items-center justify-end gap-3">
            <a href="{{ path('app_issues_index') }}"
               class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors">
                {{ 'issue.cancel'|trans({}, 'admin') }}
            </a>
            <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-forest-700 transition-colors shadow-xs">
                {{ ux_icon('heroicons:check', {class: 'h-4 w-4'}) }}{{ 'issue.new.submit'|trans({}, 'admin') }}
            </button>
        </div>
    </form>

</div>
{% endblock %}

{% block javascripts %}{{ parent() }}
<script type="module">
import TomSelect from 'tom-select';

// Tipo y dependencia con buscador (desplegable sobre <body> para que no lo recorte la tarjeta).
for (const id of ['type', 'location']) {
    const el = document.getElementById(id);
    if (!el) {
        continue;
    }
    new TomSelect(el, {
        create:           false,
        maxOptions:       null,
        dropdownParent:   'body',
        placeholder:      el.dataset.placeholder ?? '',
        allowEmptyOption: !el.required,
        render: {
            no_results: () => `<div class="no-results px-3 py-2 text-sm">${el.dataset.noResults ?? ''}</div>`,
        },
    });
}
</script>
{% endblock %}
