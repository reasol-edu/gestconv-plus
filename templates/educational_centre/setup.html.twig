{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'setup.title'|trans({}, 'admin') }} · {{ centre.name }} · {{ app_name }}{% endblock %}

{% block content %}
<div class="px-6 py-8 max-w-4xl mx-auto space-y-6">

    <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 flex-wrap">
            {% include 'components/_breadcrumb_home.html.twig' %}
            <a href="{{ path('app_centre_index', {centreId: centre.id}) }}" class="hover:text-forest-600 transition-colors">{{ 'educational_centre'|trans({}, 'navigation') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
            <span aria-current="page" class="text-gray-700 font-medium">{{ 'setup.title'|trans({}, 'admin') }}</span>
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ 'setup.title'|trans({}, 'admin') }}</h1>
        <p class="mt-1 text-sm text-gray-500">
            {% if checklist.year %}{{ 'setup.intro'|trans({'%year%': checklist.year.name}, 'admin') }}{% else %}{{ 'setup.no_year'|trans({}, 'admin') }}{% endif %}
        </p>
    </div>

    {% if checklist.year %}
        <div class="rounded-2xl border {{ checklist.complete ? 'border-emerald-200 bg-emerald-50' : 'border-gray-200 bg-white' }} p-5 shadow-xs">
            <div class="flex items-center justify-between gap-4">
                <p class="text-sm font-semibold {{ checklist.complete ? 'text-emerald-800' : 'text-gray-900' }}">
                    {{ 'setup.progress'|trans({'%done%': checklist.requiredDone, '%total%': checklist.requiredTotal}, 'admin') }}
                </p>
                <p class="text-sm font-bold tabular-nums {{ checklist.complete ? 'text-emerald-700' : 'text-forest-700' }}">{{ checklist.percent }} %</p>
            </div>
            <div class="mt-3 h-2.5 overflow-hidden rounded-full bg-gray-100" role="progressbar" aria-valuenow="{{ checklist.percent }}" aria-valuemin="0" aria-valuemax="100"
                 aria-label="{{ 'setup.progress'|trans({'%done%': checklist.requiredDone, '%total%': checklist.requiredTotal}, 'admin') }}">
                <div class="h-full rounded-full {{ checklist.complete ? 'bg-emerald-500' : 'bg-forest-500' }}" style="width: {{ checklist.percent }}%"></div>
            </div>
            {% if checklist.complete %}
                <p class="mt-3 text-sm text-emerald-800">{{ 'setup.complete'|trans({}, 'admin') }}</p>
            {% endif %}
        </div>
    {% endif %}

    <ol class="space-y-3">
        {% for item in checklist.items %}
            {% set step = item.step %}
            <li id="step-{{ step.value }}" class="rounded-2xl border border-gray-200 bg-white p-5 shadow-xs {{ item.blocked ? 'opacity-60' : '' }}">
                <div class="flex items-start gap-4">
                    <div class="mt-0.5 shrink-0 {{ item.done ? 'text-emerald-500' : (item.blocked ? 'text-gray-300' : 'text-amber-500') }}" aria-hidden="true">
                        {% if item.done %}
                            {{ ux_icon('heroicons:check-circle', {class: 'h-6 w-6'}) }}
                        {% elseif item.blocked %}
                            {{ ux_icon('heroicons:lock-closed', {class: 'h-6 w-6'}) }}
                        {% else %}
                            {{ ux_icon('heroicons:clock', {class: 'h-6 w-6'}) }}
                        {% endif %}
                    </div>

                    <div class="min-w-0 flex-1">
                        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                            <h2 class="text-base font-semibold text-gray-900">{{ ('setup.step.' ~ step.value ~ '.title')|trans({}, 'admin') }}</h2>
                            <span class="rounded-full px-2 py-0.5 text-xs font-medium {{ item.required ? 'bg-forest-100 text-forest-700' : 'bg-gray-100 text-gray-600' }}">
                                {{ (item.required ? 'setup.badge.required' : 'setup.badge.optional')|trans({}, 'admin') }}
                            </span>
                            {% if step.manual %}
                                <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800">{{ 'setup.badge.manual'|trans({}, 'admin') }}</span>
                            {% endif %}
                            <span class="sr-only">{{ (item.done ? 'setup.state.done' : (item.blocked ? 'setup.state.blocked' : 'setup.state.pending'))|trans({}, 'admin') }}</span>
                        </div>
                        <p class="mt-1 text-sm text-gray-500">{{ ('setup.step.' ~ step.value ~ '.help')|trans({}, 'admin') }}</p>
                        {% if item.detailKey %}
                            <p class="mt-1.5 text-xs font-medium {{ item.done ? 'text-emerald-700' : 'text-amber-700' }}">{{ item.detailKey|trans(item.detailParams, 'admin') }}</p>
                        {% endif %}
                        {% if item.done and step.manual and item.confirmedAt %}
                            <p class="mt-1.5 text-xs text-gray-500">
                                {% if item.confirmedBy %}
                                    {{ 'setup.confirmed_by'|trans({'%name%': item.confirmedBy, '%date%': item.confirmedAt|date('format.date'|trans)}, 'admin') }}
                                {% else %}
                                    {{ 'setup.confirmed_on'|trans({'%date%': item.confirmedAt|date('format.date'|trans)}, 'admin') }}
                                {% endif %}
                            </p>
                        {% endif %}
                    </div>

                    {% if not item.blocked or step.value == 'active_year' %}
                        <div class="flex shrink-0 flex-col items-end gap-2 sm:flex-row sm:items-center">
                            <a href="{{ path(step.route, {centreId: centre.id}) }}"
                               class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 bg-white px-3 py-2 text-xs font-medium text-gray-700
                                      hover:bg-gray-50 hover:text-forest-700 transition-colors">
                                {{ (item.done ? 'setup.review' : 'setup.go')|trans({}, 'admin') }}
                                {{ ux_icon('heroicons:arrow-right', {class: 'h-3.5 w-3.5'}) }}
                            </a>
                            {% if step.manual and not item.blocked %}
                                <form method="post" action="{{ path(item.done ? 'app_centre_setup_unconfirm' : 'app_centre_setup_confirm', {centreId: centre.id, step: step.value}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('setup_step_' ~ step.value) }}">
                                    <button type="submit"
                                            class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-xs font-medium transition-colors
                                                   {{ item.done ? 'border border-gray-200 bg-white text-gray-600 hover:bg-gray-50' : 'bg-forest-600 text-white hover:bg-forest-700 shadow-xs' }}">
                                        {{ (item.done ? 'setup.unconfirm' : 'setup.confirm')|trans({}, 'admin') }}
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </li>
        {% endfor %}
    </ol>
</div>
{% endblock %}
