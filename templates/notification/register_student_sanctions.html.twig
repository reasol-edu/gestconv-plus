{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'notification.register_student_sanctions.title'|trans({}, 'notifications') }} · {{ centre.name }} · {{ app_name }}{% endblock %}

{% block content %}
<div class="px-6 py-8 max-w-3xl mx-auto space-y-6">

    <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 flex-wrap">
            {% include 'components/_breadcrumb_home.html.twig' %}
            <a href="{{ path('app_notifications_index') }}" class="hover:text-forest-600 transition-colors">{{ 'notification.title'|trans({}, 'notifications') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
            <span aria-current="page" class="text-gray-700 font-medium">{{ 'notification.register_student_sanctions.title'|trans({}, 'notifications') }}</span>
        </div>
        <h1 class="text-2xl font-bold text-gray-900">
            {{ student.name.lastName }}, {{ student.name.firstName }}
        </h1>
        <p class="mt-1 text-sm text-gray-500">
            {{ 'notification.register_student_sanctions.count'|trans({'%count%': sanctions|length}, 'notifications') }}
        </p>
    </div>

    <form method="post" action="{{ path('app_notifications_register_student_sanctions', {studentId: student.id}) }}"
          data-controller="report-selection form-submit" class="space-y-6">
        <input type="hidden" name="_token" value="{{ csrf_token('register_student_sanctions_' ~ student.id) }}">

        <div data-report-selection-target="error" class="hidden rounded-xl px-4 py-3 text-sm font-medium bg-red-50 text-red-800 border border-red-200">
            {{ 'notification.register_student_sanctions.select_error'|trans({}, 'notifications') }}
        </div>

        <div class="space-y-3">
            {% for sanction in sanctions %}
                <div class="rounded-2xl border border-gray-200 bg-white shadow-xs p-5">
                    <div class="flex items-start gap-3">
                        <input type="checkbox" name="sanction_ids[]" value="{{ sanction.id.toRfc4122 }}" checked
                               data-report-selection-target="checkbox"
                               class="mt-1 h-4 w-4 shrink-0 rounded border-gray-300 text-forest-600 focus:ring-forest-500">
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-semibold text-gray-900">
                                {{ 'notification.register_sanction.sanction_ref'|trans({'%date%': sanction.createdAt|date('format.date'|trans)}, 'notifications') }}
                            </p>
                            <p class="text-xs text-gray-500 mt-0.5">
                                {{ sanction.group.name }} · {{ sanction.createdAt|date('format.datetime'|trans) }}
                                · {{ sanction.registeredBy.name.lastName }}, {{ sanction.registeredBy.name.firstName }}
                            </p>
                            <div class="flex flex-wrap gap-2 mt-2">
                                {% if sanction.noMeasureApplied %}
                                    <span class="inline-flex items-center rounded-full bg-gray-100 text-gray-600 px-2.5 py-0.5 text-xs font-medium">
                                        {{ 'sanction.badge.no_measure'|trans({}, 'admin') }}
                                    </span>
                                {% else %}
                                    {% for measure in sanction.measures %}
                                        <span class="inline-flex items-center rounded-full bg-blue-100 text-blue-700 px-2.5 py-0.5 text-xs font-medium">
                                            {{ measure.name }}
                                        </span>
                                    {% endfor %}
                                {% endif %}
                            </div>
                            <details class="mt-3">
                                <summary class="cursor-pointer text-xs font-semibold text-forest-700 hover:text-forest-900 select-none">
                                    {{ 'notification.register_student_sanctions.details_toggle'|trans({}, 'notifications') }}
                                </summary>
                                <div class="mt-3 rounded-xl border border-gray-100 p-4">
                                    <div class="prose prose-sm max-w-none text-gray-700">{{ sanction.details|sanitize_html('app.rich_text') }}</div>
                                </div>
                            </details>
                            <p class="mt-2">
                                <a href="{{ path('app_sanctions_show', {id: sanction.id}) }}" class="text-xs text-forest-700 hover:text-forest-900 font-medium transition-colors">
                                    {{ 'notification.register_sanction.view_sanction'|trans({}, 'notifications') }}
                                </a>
                            </p>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        {% if methods is not empty %}
            <div class="rounded-2xl border border-gray-200 bg-white shadow-xs p-6 space-y-5">
                <h2 class="text-base font-semibold text-gray-900">{{ 'notification.form.title'|trans({}, 'notifications') }}</h2>
                {% include 'notification/_communication_form_fields.html.twig' with { methods: methods } %}
                <div class="flex items-center justify-end gap-3 pt-2">
                    <button type="submit"
                            class="inline-flex items-center gap-2 rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white
                                   hover:bg-forest-700 transition-colors shadow-xs">
                        {{ ux_icon('heroicons:check', {class: 'h-4 w-4'}) }}
                        {{ 'notification.register_student_sanctions.submit'|trans({}, 'notifications') }}
                    </button>
                </div>
            </div>
        {% endif %}
    </form>

    {% if methods is empty %}
        <div class="rounded-xl px-4 py-3 text-sm font-medium bg-amber-50 text-amber-800 border border-amber-200">
            {{ 'notification.form.no_methods'|trans({}, 'notifications') }}
        </div>
    {% endif %}

</div>
{% endblock %}
