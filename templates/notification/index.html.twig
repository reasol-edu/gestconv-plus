{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'notification.title'|trans({}, 'notifications') }} · {{ centre.name }} · {{ app_name }}{% endblock %}

{% block content %}
<div class="px-6 py-8 max-w-7xl mx-auto space-y-6">

    <div>
        <h1 class="text-2xl font-bold text-gray-900">{{ 'notification.title'|trans({}, 'notifications') }}</h1>
        <p class="mt-1 text-sm text-gray-500">{{ 'notification.index.help'|trans({}, 'notifications') }}</p>
    </div>

    {# ── Pestañas ─────────────────────────────────────────────────────── #}
    <nav class="flex gap-6 border-b border-gray-200" aria-label="{{ 'notification.tabs.aria'|trans({}, 'notifications') }}">
        <a href="{{ path('app_notifications_index', {tab: 'pending'}) }}"
           {% if tab == 'pending' %}aria-current="page"{% endif %}
           class="-mb-px inline-flex items-center gap-2 border-b-2 px-1 py-3 text-sm font-medium transition-colors
                  {{ tab == 'pending' ? 'border-forest-600 text-forest-700' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }}">
            {{ ux_icon('heroicons:bell-alert', {class: 'h-4 w-4'}) }}
            {{ 'notification.tabs.pending'|trans({}, 'notifications') }}
        </a>
        <a href="{{ path('app_notifications_index', {tab: 'history'}) }}"
           {% if tab == 'history' %}aria-current="page"{% endif %}
           class="-mb-px inline-flex items-center gap-2 border-b-2 px-1 py-3 text-sm font-medium transition-colors
                  {{ tab == 'history' ? 'border-forest-600 text-forest-700' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }}">
            {{ ux_icon('heroicons:clock', {class: 'h-4 w-4'}) }}
            {{ 'notification.tabs.history'|trans({}, 'notifications') }}
        </a>
    </nav>

    {% if tab == 'pending' %}
    {# ── Partes próximos a prescribir (solo si los hay) ───────────────── #}
    {% if upcoming is not empty %}
    <section aria-labelledby="upcoming-title" class="rounded-2xl border border-red-200 bg-red-50 shadow-xs overflow-hidden">
        <div class="flex flex-wrap items-center gap-3 px-6 py-4 border-b border-red-200/70">
            {{ ux_icon('heroicons:exclamation-triangle', {class: 'h-5 w-5 text-red-600'}) }}
            <h2 id="upcoming-title" class="text-base font-semibold text-red-900">{{ 'notification.upcoming.title'|trans({}, 'notifications') }}</h2>
            <span class="inline-flex items-center rounded-full bg-red-600 text-white px-2.5 py-0.5 text-xs font-semibold">{{ upcoming|length }}</span>
            <p class="basis-full text-sm text-red-800">{{ 'notification.upcoming.help'|trans({}, 'notifications') }}</p>
        </div>
        <ul class="divide-y divide-red-200/70">
            {% for item in upcoming %}
                {% set report = item.report %}
                <li class="flex flex-wrap items-center gap-x-6 gap-y-2 px-6 py-3 text-sm">
                    <span class="min-w-48 flex-1 font-medium text-red-950">{{ report.student.name.lastName }}, {{ report.student.name.firstName }}</span>
                    <span class="text-red-800 whitespace-nowrap">{{ report.group.name }}</span>
                    <span class="text-red-800 whitespace-nowrap">{{ report.occurredAt|date('format.datetime'|trans) }}</span>
                    <span class="inline-flex items-center rounded-lg bg-white/80 px-2.5 py-1 text-xs font-semibold text-red-700 ring-1 ring-red-200 whitespace-nowrap">
                        {{ 'notification.upcoming.in_days'|trans({'%count%': item.daysLeft}, 'notifications') }}
                    </span>
                    <div class="flex items-center gap-2">
                        <a href="{{ path('app_incidents_show', {id: report.id}) }}"
                           class="inline-flex items-center gap-1 rounded-lg border border-red-200 bg-white px-2.5 py-1.5 text-xs font-medium
                                  text-gray-700 hover:bg-gray-50 transition-colors">
                            {{ ux_icon('heroicons:eye', {class: 'h-3.5 w-3.5'}) }}
                            {{ 'notification.index.view'|trans({}, 'notifications') }}
                        </a>
                        {% if is_granted('incident_report.notify', report) and not is_viewing_past_year() %}
                            <a href="{{ path('app_notifications_register_report', {id: report.id}) }}"
                               class="inline-flex items-center gap-1.5 rounded-lg bg-forest-600 px-3 py-1.5 text-xs font-semibold text-white
                                      hover:bg-forest-700 transition-colors shadow-xs">
                                {{ ux_icon('heroicons:bell-alert', {class: 'h-3.5 w-3.5'}) }}
                                {{ 'notification.index.notify'|trans({}, 'notifications') }}
                            </a>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ul>
    </section>
    {% endif %}

    {# ── Estudiantes con notificaciones pendientes ─────────────────── #}
    <div class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden">
        <twig:PendingReportsByStudentComponent :centre="centre" />
    </div>

    {# ── Partes pendientes ─────────────────────────────────────────── #}
    <div class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden">
        <twig:PendingReportListComponent :centre="centre" />
    </div>

    {# ── Sanciones pendientes ──────────────────────────────────────── #}
    <div class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden">
        <twig:PendingSanctionListComponent :centre="centre" />
    </div>
    {% else %}
    {# ── Historial de notificaciones ──────────────────────────────────── #}
    <div class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden">
        <twig:CommunicationHistoryListComponent :centre="centre" />
    </div>
    {% endif %}

</div>
{% endblock %}
