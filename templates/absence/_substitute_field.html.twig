{# Casilla «Existe docente sustituto/a»: con ella marcada la ausencia está cubierta y no se muestra ni pide tareas. #}
<div class="rounded-2xl border border-gray-200 bg-white shadow-xs p-6">
    <label class="flex cursor-pointer items-start gap-3">
        <input type="checkbox" name="has_substitute" value="1" {{ formData.has_substitute ?? false ? 'checked' : '' }}
               class="mt-0.5 h-4 w-4 rounded border-gray-300 text-forest-600 focus:ring-forest-500">
        <span>
            <span class="block text-sm font-medium text-gray-800">{{ 'absence.field.has_substitute'|trans({}, 'admin') }}</span>
            <span class="mt-0.5 block text-xs text-gray-500">{{ 'absence.field.has_substitute_help'|trans({}, 'admin') }}</span>
        </span>
    </label>
</div>
