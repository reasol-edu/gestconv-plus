{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'school_event.students.title'|trans({}, 'admin') }} · {{ event.name }} · {{ app_name }}{% endblock %}

{% block content %}
<div class="px-6 py-8 max-w-4xl mx-auto space-y-6">

    <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 flex-wrap">
            {% include 'components/_breadcrumb_home.html.twig' %}
            <a href="{{ path('app_events_index') }}" class="hover:text-forest-600 transition-colors">{{ 'school_event.title'|trans({}, 'admin') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
            <a href="{{ path('app_events_show', {eventId: event.id.toRfc4122}) }}" class="hover:text-forest-600 transition-colors">{{ event.name }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ 'school_event.students.title'|trans({}, 'admin') }}</h1>
        <p class="mt-1 text-sm text-gray-500">{{ 'school_event.students.intro'|trans({'%name%': event.name}, 'admin') }}</p>
    </div>

    {% if courses is empty %}
        <div class="rounded-2xl border border-gray-200 bg-white shadow-xs px-6 py-10 text-center">
            <p class="text-sm text-gray-500">{{ 'school_event.students.no_groups'|trans({}, 'admin') }}</p>
            <a href="{{ path('app_events_edit', {eventId: event.id.toRfc4122}) }}"
               class="mt-3 inline-flex items-center gap-2 text-sm font-medium text-forest-700 hover:text-forest-900 transition-colors">
                {{ 'school_event.action.edit'|trans({}, 'admin') }}
            </a>
        </div>
    {% else %}
        <form method="post"
              data-controller="student-picker unsaved-changes"
              data-student-picker-select-label-value="{{ 'school_event.students.select_all'|trans({}, 'admin')|e('html_attr') }}"
              data-student-picker-deselect-label-value="{{ 'school_event.students.deselect_all'|trans({}, 'admin')|e('html_attr') }}"
              data-student-picker-count-label-value="{{ 'school_event.students.count'|trans({}, 'admin')|e('html_attr') }}"
              class="space-y-4">
            <input type="hidden" name="_token" value="{{ csrf_token('event_students_' ~ event.id.toRfc4122) }}">

            <div class="relative">
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4">
                    {{ ux_icon('heroicons:magnifying-glass', {class: 'h-5 w-5 text-gray-400'}) }}
                </div>
                <input type="search" data-student-picker-target="search" data-action="input->student-picker#filter"
                       placeholder="{{ 'school_event.students.search'|trans({}, 'admin') }}" autocomplete="off"
                       class="block w-full rounded-2xl border border-gray-200 bg-white py-3 pl-12 pr-4 text-sm text-gray-900 placeholder-gray-400
                              focus:border-forest-500 focus:outline-none focus:ring-3 focus:ring-forest-500/20 transition-colors">
            </div>

            <div class="flex items-center justify-end">
                <button type="button" data-student-picker-target="toggleAll" data-action="student-picker#toggleAll"
                        class="text-sm font-medium text-forest-600 hover:text-forest-800 transition-colors"></button>
            </div>

            {% for entry in courses %}
                <section data-student-picker-target="course" class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden">
                    <h2 class="flex items-center gap-2.5 px-5 py-3.5 bg-gray-50 border-b border-gray-100 text-sm font-semibold text-gray-800">
                        <span class="h-2 w-2 rounded-full" style="background-color: {{ group_color(entry.groups[0].group).hex }}"></span>
                        {{ entry.course.name }}
                    </h2>
                    <div class="p-4 space-y-5">
                        {% for item in entry.groups %}
                            <div data-student-picker-target="group">
                                <div class="flex items-center justify-between gap-3 mb-2.5">
                                    <h3 class="flex items-center gap-2 text-sm font-medium text-gray-600">
                                        {{ ux_icon('heroicons:user-group', {class: 'h-4 w-4 text-gray-400'}) }}{{ item.group.name }}
                                    </h3>
                                    {% if item.students is not empty %}
                                        <button type="button" data-student-picker-target="toggleGroup" data-action="student-picker#toggleGroup"
                                                class="text-sm font-medium text-forest-600 hover:text-forest-800 transition-colors"></button>
                                    {% endif %}
                                </div>
                                {% if item.students is empty %}
                                    <p class="text-sm text-gray-400">{{ 'school_event.students.group_empty'|trans({}, 'admin') }}</p>
                                {% else %}
                                    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                                        {% for student in item.students %}
                                            <label data-student-picker-target="row" data-name="{{ student.name.full() }}"
                                                   class="flex items-center gap-3 rounded-xl border border-gray-200 px-4 py-3 cursor-pointer transition-colors
                                                          hover:border-gray-300 has-[:checked]:border-forest-400 has-[:checked]:bg-forest-50">
                                                <input type="checkbox" name="students[]" value="{{ student.id.toRfc4122 }}"
                                                       {{ student.id.toRfc4122 in selectedIds ? 'checked' : '' }}
                                                       data-student-picker-target="checkbox" data-action="change->student-picker#changed"
                                                       class="h-5 w-5 shrink-0 rounded border-gray-300 text-forest-600 focus:ring-forest-500">
                                                <span class="text-sm text-gray-900">{{ student.name.full() }}</span>
                                            </label>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </section>
            {% endfor %}

            <div class="sticky bottom-0 -mx-6 px-6 py-3 bg-white/90 backdrop-blur border-t border-gray-200 flex items-center justify-between gap-3">
                <a href="{{ path('app_events_show', {eventId: event.id.toRfc4122}) }}"
                   class="text-sm text-gray-500 hover:text-gray-700 transition-colors">{{ 'school_event.cancel'|trans({}, 'admin') }}</a>
                <div class="flex items-center gap-4">
                    <span class="text-sm text-gray-500" data-student-picker-target="count"></span>
                    <button type="submit"
                            class="inline-flex items-center gap-2 rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-forest-700 transition-colors shadow-xs">
                        {{ ux_icon('heroicons:check', {class: 'h-4 w-4'}) }}
                        {{ 'school_event.save'|trans({}, 'admin') }}
                    </button>
                </div>
            </div>
        </form>
    {% endif %}
</div>
{% endblock %}
