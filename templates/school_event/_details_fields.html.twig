{# Tipo y datos opcionales de la actividad (lugar, departamento, coordinación y acompañantes). Comparte formulario con new/edit. #}
<div class="rounded-2xl border border-gray-200 bg-white shadow-xs p-6 space-y-5">
    <h2 class="text-base font-semibold text-gray-900">{{ 'school_event.section.details'|trans({}, 'admin') }}</h2>

    <div>
        <label for="type" class="block text-sm font-medium text-gray-700 mb-1.5">
            {{ 'school_event.field.type'|trans({}, 'admin') }} <span class="text-red-500" aria-hidden="true">*</span>
        </label>
        <select id="type" name="type" required
                class="block w-full rounded-xl border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-sm text-gray-900
                       focus:border-forest-500 focus:bg-white focus:outline-none focus:ring-3 focus:ring-forest-500/20 transition-colors
                       {{ errors.type is defined ? 'border-red-300' : '' }}">
            {% for type in availableTypes %}
                <option value="{{ type.id.toRfc4122 }}" {{ values.type == type.id.toRfc4122 ? 'selected' : '' }}>{{ type.name }}</option>
            {% endfor %}
        </select>
        {% if errors.type is defined %}
            <p class="mt-1.5 text-xs text-red-600">{{ errors.type }}</p>
        {% endif %}
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        {# Texto libre (no una referencia al catálogo), con las ubicaciones del centro como sugerencias. #}
        <div>
            <label for="location" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'school_event.field.location'|trans({}, 'admin') }}</label>
            <select id="location" name="location" class="w-full text-sm ts-local"
                    data-placeholder="{{ 'school_event.field.location_placeholder'|trans({}, 'admin')|e('html_attr') }}"
                    data-create-label="{{ 'school_event.field.location_create'|trans({}, 'admin')|e('html_attr') }}"
                    data-no-results="{{ 'school_event.field.groups_no_results'|trans({}, 'admin')|e('html_attr') }}">
                <option value=""></option>
                {% set known = [] %}
                {% for option in availableLocations|default([]) %}{% set known = known|merge([option.name]) %}{% endfor %}
                {% if values.location != '' and values.location not in known %}
                    <option value="{{ values.location }}" selected>{{ values.location }}</option>
                {% endif %}
                {% set lastCategory = null %}
                {% for option in availableLocations|default([]) %}
                    {% if option.category.id.toRfc4122 != lastCategory %}
                        {% if lastCategory is not null %}</optgroup>{% endif %}
                        <optgroup label="{{ option.category.name }}">
                        {% set lastCategory = option.category.id.toRfc4122 %}
                    {% endif %}
                    <option value="{{ option.name }}" {{ values.location == option.name ? 'selected' : '' }}>{{ option.name }}</option>
                    {% if loop.last %}</optgroup>{% endif %}
                {% endfor %}
            </select>
        </div>

        <twig:Form:Field
            id="organizing_department" name="organizing_department" type="text"
            label="{{ 'school_event.field.organizing_department'|trans({}, 'admin') }}"
            value="{{ values.organizing_department }}"
            maxlength="255" />
    </div>

    <div>
        <label for="coordinator" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'school_event.field.coordinator'|trans({}, 'admin') }}</label>
        <select id="coordinator" name="coordinator" class="w-full text-sm ts-local ts-person-teacher"
                data-placeholder="{{ 'school_event.field.coordinator_placeholder'|trans({}, 'admin')|e('html_attr') }}"
                data-no-results="{{ 'school_event.field.groups_no_results'|trans({}, 'admin')|e('html_attr') }}">
            <option value=""></option>
            {% for teacher in availableTeachers %}
                <option value="{{ teacher.id.toRfc4122 }}" {{ values.coordinator == teacher.id.toRfc4122 ? 'selected' : '' }}>{{ teacher.name.full() }}</option>
            {% endfor %}
        </select>
    </div>

    <div>
        <label for="companions" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'school_event.field.companions'|trans({}, 'admin') }}</label>
        <select id="companions" name="companions[]" multiple class="w-full text-sm ts-local ts-person-teacher"
                data-placeholder="{{ 'school_event.field.companions_placeholder'|trans({}, 'admin')|e('html_attr') }}"
                data-no-results="{{ 'school_event.field.groups_no_results'|trans({}, 'admin')|e('html_attr') }}">
            {% for teacher in availableTeachers %}
                <option value="{{ teacher.id.toRfc4122 }}" {{ teacher.id.toRfc4122 in selectedCompanionIds ? 'selected' : '' }}>{{ teacher.name.full() }}</option>
            {% endfor %}
        </select>
        <p class="mt-1.5 text-xs text-gray-500">{{ 'school_event.field.companions_help'|trans({}, 'admin') }}</p>
    </div>
</div>

<div class="rounded-2xl border border-gray-200 bg-white shadow-xs p-6 space-y-3">
    <h2 class="text-base font-semibold text-gray-900">{{ 'school_event.section.status'|trans({}, 'admin') }}</h2>
    <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
        <twig:Form:RadioCard
            name="draft"
            value="0"
            label="{{ 'school_event.status.published'|trans({}, 'admin') }}"
            help="{{ 'school_event.status.published_help'|trans({}, 'admin') }}"
            :checked="values.draft != '1'" />

        <twig:Form:RadioCard
            name="draft"
            value="1"
            tone="gray"
            label="{{ 'school_event.status.draft'|trans({}, 'admin') }}"
            help="{{ 'school_event.status.draft_help'|trans({}, 'admin') }}"
            :checked="values.draft == '1'" />
    </div>
</div>
