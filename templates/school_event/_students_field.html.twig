{# Estudiantes de la actividad, opcionales y de entre los de los grupos marcados (Tom Select; se oculta sin grupos). #}
{% if studentOptions is not empty %}
    <div id="students-field" class="hidden">
        <label for="students" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'school_event.field.students'|trans({}, 'admin') }}</label>
        <select id="students" name="students[]" multiple class="w-full text-sm ts-local"
                data-options="{{ studentOptions|json_encode|e('html_attr') }}"
                data-placeholder="{{ 'school_event.field.students_placeholder'|trans({}, 'admin')|e('html_attr') }}"
                data-no-results="{{ 'school_event.field.groups_no_results'|trans({}, 'admin')|e('html_attr') }}">
            {% for student in studentOptions %}
                {% if student.id in selectedStudentIds %}
                    <option value="{{ student.id }}" selected>{{ student.name }}</option>
                {% endif %}
            {% endfor %}
        </select>
        <p class="mt-1.5 text-xs text-gray-500">{{ 'school_event.field.students_help'|trans({}, 'admin') }}</p>
    </div>

    <script type="module">
    import TomSelect from 'tom-select';

    const select = document.getElementById('students');
    const groups = document.getElementById('groups');
    const field  = document.getElementById('students-field');

    if (select && groups && field) {
        const all = JSON.parse(select.dataset.options);
        const ts  = new TomSelect(select, {
            create:         false,
            maxOptions:     null,
            dropdownParent: 'body',
            placeholder:    select.dataset.placeholder ?? '',
            plugins:        ['remove_button', 'checkbox_options'],
            render: {
                no_results: () => `<div class="no-results px-3 py-2 text-sm">${select.dataset.noResults ?? ''}</div>`,
            },
        });

        // Solo se ofrecen los estudiantes de los grupos marcados; al quitar un grupo se descartan los suyos.
        const sync = () => {
            const chosen  = Array.from(groups.selectedOptions).map((o) => o.value);
            const allowed = all.filter((s) => s.groups.some((g) => chosen.includes(g)));
            const ids     = new Set(allowed.map((s) => s.id));

            field.classList.toggle('hidden', chosen.length === 0);
            ts.items.filter((id) => !ids.has(id)).forEach((id) => ts.removeItem(id, true));
            ts.clearOptions();
            ts.addOptions(allowed.map((s) => ({ value: s.id, text: s.name })));
            ts.refreshOptions(false);
        };

        groups.addEventListener('change', sync);
        sync();
    }
    </script>
{% endif %}
