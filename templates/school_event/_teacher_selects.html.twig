{# Búsqueda para el coordinador, los acompañantes y el lugar (Tom Select, desplegable en <body> para que no lo recorte la tarjeta). #}
<script type="module">
import TomSelect from 'tom-select';

for (const id of ['coordinator', 'companions', 'location']) {
    const el = document.getElementById(id);
    if (!el) {
        continue;
    }

    // El lugar es texto libre: las ubicaciones del centro se sugieren, pero se puede escribir cualquier cosa.
    const free   = id === 'location';
    const render = {
        no_results: () => `<div class="no-results px-3 py-2 text-sm">${el.dataset.noResults ?? ''}</div>`,
    };
    if (free) {
        render.option_create = (data, escape) => `<div class="create px-3 py-2 text-sm">${escape(el.dataset.createLabel ?? '')} <strong>${escape(data.input)}</strong></div>`;
    }

    new TomSelect(el, {
        create:           free,
        createOnBlur:     free,
        persist:          false,
        maxOptions:       null,
        dropdownParent:   'body',
        placeholder:      el.dataset.placeholder ?? '',
        allowEmptyOption: true,
        plugins:          el.multiple ? ['remove_button', 'checkbox_options'] : [],
        render,
    });
}
</script>
