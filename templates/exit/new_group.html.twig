{% extends 'layouts/app.html.twig' %}

{% macro group_button(group, mine) %}
    <a href="{{ path('app_exits_new', {groupId: group.id}) }}"
       class="flex min-h-16 items-center justify-center rounded-2xl border-2 px-3 py-3 text-center text-lg font-semibold shadow-xs transition-colors
              {{ mine ? 'border-forest-600 bg-forest-600 text-white active:bg-forest-800 hover:bg-forest-700' : 'border-gray-200 bg-white text-gray-800 hover:border-forest-300 hover:bg-forest-50 active:bg-forest-100' }}">
        {{ group.name }}
    </a>
{% endmacro %}

{% import _self as g %}

{% block title %}{{ 'exit.authorize'|trans({}, 'admin') }} · {{ centre.name }} · {{ app_name }}{% endblock %}

{% block content %}
<div class="mx-auto max-w-4xl space-y-6 px-4 py-6 sm:px-6 sm:py-8">

    <div>
        <a href="{{ path('app_exits_index') }}" class="inline-flex min-h-11 items-center gap-1 text-sm font-medium text-gray-500 hover:text-forest-700">
            {{ ux_icon('heroicons:chevron-left', {class: 'h-4 w-4'}) }}
            {{ 'exit.title'|trans({}, 'admin') }}
        </a>
        <h1 class="text-2xl font-bold text-gray-900">{{ 'exit.new.title'|trans({}, 'admin') }}</h1>
        <p class="mt-1 text-sm text-gray-500">{{ 'exit.new.step_group'|trans({}, 'admin') }}</p>
    </div>

    {% if mine is not empty %}
        <section aria-labelledby="exit-mine-groups">
            <h2 id="exit-mine-groups" class="mb-3 text-sm font-semibold uppercase tracking-wide text-forest-800">{{ 'exit.new.my_groups'|trans({}, 'admin') }}</h2>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
                {% for group in mine %}{{ g.group_button(group, true) }}{% endfor %}
            </div>
        </section>
    {% endif %}

    {% if others is not empty %}
        <section aria-labelledby="exit-other-groups">
            <h2 id="exit-other-groups" class="mb-3 text-sm font-semibold uppercase tracking-wide text-gray-600">
                {{ (mine is empty ? 'exit.new.groups' : 'exit.new.other_groups')|trans({}, 'admin') }}
            </h2>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
                {% for group in others %}{{ g.group_button(group, false) }}{% endfor %}
            </div>
        </section>
    {% endif %}

    {% if mine is empty and others is empty %}
        <p class="rounded-2xl border border-dashed border-gray-300 bg-white px-6 py-10 text-center text-sm text-gray-500">{{ 'exit.new.no_groups'|trans({}, 'admin') }}</p>
    {% endif %}
</div>
{% endblock %}
