{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'exit.title'|trans({}, 'admin') }} · {{ centre.name }} · {{ app_name }}{% endblock %}

{% block content %}
<div class="mx-auto max-w-6xl space-y-5 px-4 py-6 pb-28 sm:space-y-6 sm:px-6 sm:py-8 sm:pb-8">

    <div class="flex items-start justify-between gap-4">
        <div class="min-w-0">
            <div class="mb-1 flex flex-wrap items-center gap-2 text-sm text-gray-500">
                {% include 'components/_breadcrumb_home.html.twig' %}
            </div>
            <h1 class="text-2xl font-bold text-gray-900">{{ 'exit.title'|trans({}, 'admin') }}</h1>
            <p class="mt-1 text-sm text-gray-500">{{ 'exit.subtitle'|trans({}, 'admin') }}</p>
        </div>
        {% if canCreate %}
            <a href="{{ path('app_exits_new') }}"
               class="hidden shrink-0 items-center gap-2 rounded-xl bg-forest-600 px-5 py-3 text-base font-semibold text-white shadow-xs transition-colors hover:bg-forest-700 sm:inline-flex">
                {{ ux_icon('heroicons:arrow-right-on-rectangle', {class: 'h-5 w-5'}) }}
                {{ 'exit.authorize'|trans({}, 'admin') }}
            </a>
        {% endif %}
    </div>

    {% if canManage %}
        <nav class="flex gap-1 border-b border-gray-200" aria-label="{{ 'exit.title'|trans({}, 'admin') }}">
            {% for key in ['current', 'history'] %}
                <a href="{{ path('app_exits_index', key == 'current' ? {} : {tab: key}) }}"
                   {{ tab == key ? 'aria-current="page"' : '' }}
                   class="-mb-px min-h-11 border-b-2 px-4 py-2.5 text-sm font-medium transition-colors
                          {{ tab == key ? 'border-forest-600 text-forest-700' : 'border-transparent text-gray-500 hover:text-gray-700' }}">
                    {{ ('exit.tab.' ~ key)|trans({}, 'admin') }}
                </a>
            {% endfor %}
        </nav>
    {% endif %}

    {% if tab == 'history' %}
        <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-xs">
            <twig:ExitHistoryListComponent :centre="centre" />
        </div>
    {% else %}
        <twig:ExitCurrentListComponent :centre="centre" />
    {% endif %}
</div>

{# En el móvil el botón principal queda fijo abajo, al alcance del pulgar. #}
{% if canCreate %}
    <div class="fixed inset-x-0 bottom-0 z-30 border-t border-gray-200 bg-white/95 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur sm:hidden">
        <a href="{{ path('app_exits_new') }}"
           class="flex min-h-14 w-full items-center justify-center gap-2 rounded-2xl bg-forest-600 px-5 py-3 text-lg font-bold text-white shadow-sm transition-colors active:bg-forest-800">
            {{ ux_icon('heroicons:arrow-right-on-rectangle', {class: 'h-6 w-6'}) }}
            {{ 'exit.authorize'|trans({}, 'admin') }}
        </a>
    </div>
{% endif %}
{% endblock %}
