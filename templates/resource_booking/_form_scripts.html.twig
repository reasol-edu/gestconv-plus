{# Buscadores del formulario de reserva: recurso, docente y grupos (Tom Select, desplegable en <body> para que no lo recorte la tarjeta). #}
<script type="module">
import TomSelect from 'tom-select';

for (const id of ['resource', 'teacher', 'groups']) {
    const el = document.getElementById(id);
    if (!el) {
        continue;
    }

    new TomSelect(el, {
        create:         false,
        maxOptions:     null,
        dropdownParent: 'body',
        placeholder:    el.dataset.placeholder ?? '',
        allowEmptyOption: !el.required,
        plugins:        el.multiple ? ['remove_button', 'checkbox_options'] : [],
        render: {
            no_results: () => `<div class="no-results px-3 py-2 text-sm">${el.dataset.noResults ?? ''}</div>`,
        },
    });
}
</script>
