{# Buscador de grupos del formulario de reserva (Tom Select, desplegable en <body> para que no lo recorte la tarjeta). #}
<script type="module">
import TomSelect from 'tom-select';

const el = document.getElementById('groups');
if (el) {
    new TomSelect(el, {
        create:         false,
        maxOptions:     null,
        dropdownParent: 'body',
        placeholder:    el.dataset.placeholder ?? '',
        plugins:        ['remove_button', 'checkbox_options'],
        render: {
            item:       (d, esc) => `<div>${esc(d.text)}</div>`,
            no_results: () => `<div class="no-results px-3 py-2 text-sm">${el.dataset.noResults ?? ''}</div>`,
        },
    });
}
</script>
