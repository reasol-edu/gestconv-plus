{# Cabecera de la sección Reservas: título, botón «Reservar» y pestañas. Variables: active ('calendar' | 'list'), canBook. #}
<div class="flex items-start justify-between gap-4 flex-wrap">
    <h1 class="text-2xl font-bold text-gray-900">{{ 'booking.title'|trans({}, 'admin') }}</h1>
    {% if canBook %}
        <a href="{{ path('app_bookings_new') }}"
           class="inline-flex items-center gap-2 rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white
                  hover:bg-forest-700 transition-colors shadow-xs shrink-0">
            {{ ux_icon('heroicons:plus', {class: 'h-4 w-4'}) }}
            {{ 'booking.add'|trans({}, 'admin') }}
        </a>
    {% endif %}
</div>

<nav class="flex gap-6 border-b border-gray-200" aria-label="{{ 'booking.tabs.aria'|trans({}, 'admin') }}">
    <a href="{{ path('app_bookings_index') }}"
       {% if active == 'calendar' %}aria-current="page"{% endif %}
       class="-mb-px inline-flex items-center gap-2 border-b-2 px-1 py-3 text-sm font-medium transition-colors
              {{ active == 'calendar' ? 'border-forest-600 text-forest-700' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }}">
        {{ ux_icon('heroicons:calendar-days', {class: 'h-4 w-4'}) }}
        {{ 'booking.tabs.calendar'|trans({}, 'admin') }}
    </a>
    <a href="{{ path('app_bookings_list') }}"
       {% if active == 'list' %}aria-current="page"{% endif %}
       class="-mb-px inline-flex items-center gap-2 border-b-2 px-1 py-3 text-sm font-medium transition-colors
              {{ active == 'list' ? 'border-forest-600 text-forest-700' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }}">
        {{ ux_icon('heroicons:list-bullet', {class: 'h-4 w-4'}) }}
        {{ 'booking.tabs.list'|trans({}, 'admin') }}
    </a>
</nav>
