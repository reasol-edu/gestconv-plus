{#
   Campos del formulario de reserva (alta y edición). Variables: values, errors, resourcesByCategory, slotsByDay,
   groups, canPickTeacher, teachers, booking (null en el alta), hasSiblings, mode ('new' | 'edit').
#}
{% set inputClass = 'block w-full rounded-xl border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-sm text-gray-900 focus:border-forest-500 focus:bg-white focus:outline-none focus:ring-3 focus:ring-forest-500/20 transition-colors' %}
{% macro error(errors, field) %}
    {% if errors[field] is defined %}
        <p class="mt-1.5 text-sm text-red-600" role="alert">{{ errors[field]|trans({}, 'admin') }}</p>
    {% endif %}
{% endmacro %}
{% import _self as f %}

{# Un docente sin selector de docente no ve el error de ese campo: se avisa arriba. #}
{% if errors.teacher is defined and not canPickTeacher %}
    <p class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">{{ errors.teacher|trans({}, 'admin') }}</p>
{% endif %}

<div class="rounded-2xl border border-gray-200 bg-white shadow-xs p-6 space-y-5">

    <div>
        <label for="resource" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'booking.field.resource'|trans({}, 'admin') }} <span class="text-red-500">*</span></label>
        <select id="resource" name="resource" required class="{{ inputClass }}">
            <option value="">{{ 'booking.field.resource_placeholder'|trans({}, 'admin') }}</option>
            {% for categoryName, list in resourcesByCategory %}
                <optgroup label="{{ categoryName }}">
                    {% for resource in list %}
                        <option value="{{ resource.id.toRfc4122 }}" {{ values.resource == resource.id.toRfc4122 ? 'selected' : '' }}>
                            {{ resource.name }}{{ resource.location ? ' · ' ~ resource.location : '' }}
                        </option>
                    {% endfor %}
                </optgroup>
            {% endfor %}
        </select>
        {{ f.error(errors, 'resource') }}
        {% if resourcesByCategory is empty %}
            <p class="mt-1.5 text-sm text-amber-700">{{ 'booking.field.no_resources'|trans({}, 'admin') }}</p>
        {% endif %}
    </div>

    {% if canPickTeacher %}
        <div>
            <label for="teacher" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'booking.field.teacher'|trans({}, 'admin') }}</label>
            <select id="teacher" name="teacher" class="{{ inputClass }}">
                {% for teacher in teachers %}
                    <option value="{{ teacher.id.toRfc4122 }}" {{ values.teacher == teacher.id.toRfc4122 ? 'selected' : '' }}>{{ teacher.name.full() }}</option>
                {% endfor %}
            </select>
            <p class="mt-1.5 text-xs text-gray-500">{{ 'booking.field.teacher_help'|trans({}, 'admin') }}</p>
            {{ f.error(errors, 'teacher') }}
        </div>
    {% endif %}

    <div class="max-w-xs">
        <label for="date" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'booking.field.date'|trans({}, 'admin') }} <span class="text-red-500">*</span></label>
        <input type="date" id="date" name="date" required value="{{ values.date }}"
               data-booking-form-target="date" data-action="change->booking-form#dateChanged input->booking-form#dateChanged"
               class="{{ inputClass }}">
        {{ f.error(errors, 'date') }}
    </div>

    <fieldset>
        <legend class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'booking.field.slots'|trans({}, 'admin') }} <span class="text-red-500">*</span></legend>
        {% if slotsByDay is empty %}
            <p class="text-sm text-amber-700">{{ 'booking.no_time_slots'|trans({}, 'admin') }}</p>
        {% else %}
            {% for day, slots in slotsByDay %}
                <div data-booking-form-target="slotGroup" data-day="{{ day }}" class="mb-3">
                    <p class="mb-1.5 text-xs font-semibold uppercase tracking-wide text-gray-400">{{ ('weekday.' ~ (day + 1))|trans({}, 'calendar') }}</p>
                    <div class="flex flex-wrap gap-2">
                        {% for slot in slots %}
                            <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm text-gray-700
                                          hover:bg-gray-50 has-checked:border-forest-500 has-checked:bg-forest-50 has-checked:text-forest-800 transition-colors">
                                <input type="checkbox" name="slots[]" value="{{ slot.id.toRfc4122 }}"
                                       {{ slot.id.toRfc4122 in values.slots ? 'checked' : '' }}
                                       class="rounded border-gray-300 text-forest-600 focus:ring-forest-500">
                                <span>{{ slot.name }} <span class="text-xs tabular-nums text-gray-400">{{ slot.startTime|date('H:i') }}–{{ slot.endTime|date('H:i') }}</span></span>
                            </label>
                        {% endfor %}
                    </div>
                </div>
            {% endfor %}
            <p data-booking-form-target="noSlots" class="hidden text-sm text-gray-500">{{ 'booking.field.no_slots_that_day'|trans({}, 'admin') }}</p>
        {% endif %}
        {{ f.error(errors, 'slots') }}
    </fieldset>

    <div>
        <label for="groups" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'booking.field.groups'|trans({}, 'admin') }}</label>
        <select id="groups" name="groups[]" multiple class="w-full text-sm ts-local"
                data-placeholder="{{ 'booking.field.groups_placeholder'|trans({}, 'admin')|e('html_attr') }}"
                data-no-results="{{ 'school_event.field.groups_no_results'|trans({}, 'admin')|e('html_attr') }}">
            {% for group in groups %}
                <option value="{{ group.id.toRfc4122 }}" {{ group.id.toRfc4122 in values.groups ? 'selected' : '' }}>{{ group.name }}</option>
            {% endfor %}
        </select>
    </div>

    <div>
        <label for="description" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'booking.field.description'|trans({}, 'admin') }}</label>
        <textarea id="description" name="description" rows="3" maxlength="2000" class="{{ inputClass }}">{{ values.description }}</textarea>
    </div>
</div>

{% if mode == 'new' %}
    <div class="rounded-2xl border border-gray-200 bg-white shadow-xs p-6 space-y-4">
        <label class="inline-flex cursor-pointer items-center gap-2 text-sm font-medium text-gray-800">
            <input type="checkbox" name="repeat" value="1" {{ values.repeat ? 'checked' : '' }}
                   data-booking-form-target="repeat" data-action="change->booking-form#repeatChanged"
                   class="rounded border-gray-300 text-forest-600 focus:ring-forest-500">
            {{ 'booking.field.repeat'|trans({}, 'admin') }}
        </label>
        <div data-booking-form-target="repeatBlock" class="{{ values.repeat ? '' : 'hidden' }} max-w-xs">
            <label for="repeat_until" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'booking.field.repeat_until'|trans({}, 'admin') }}</label>
            <input type="date" id="repeat_until" name="repeat_until" value="{{ values.repeat_until }}" class="{{ inputClass }}">
            <p class="mt-1.5 text-xs text-gray-500">{{ 'booking.field.repeat_help'|trans({'%max%': 60}, 'admin') }}</p>
            {{ f.error(errors, 'repeat_until') }}
        </div>
    </div>
{% elseif hasSiblings %}
    <div class="rounded-2xl border border-gray-200 bg-white shadow-xs p-6 space-y-3">
        <p class="text-sm font-medium text-gray-700">{{ 'booking.field.scope'|trans({}, 'admin') }}</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <twig:Form:RadioCard
                name="scope"
                value="single"
                label="{{ 'booking.scope.single'|trans({}, 'admin') }}"
                help="{{ 'booking.scope.single_help'|trans({}, 'admin') }}"
                :checked="true"
            />
            <twig:Form:RadioCard
                name="scope"
                value="series"
                label="{{ 'booking.scope.series'|trans({}, 'admin') }}"
                help="{{ 'booking.scope.series_help'|trans({}, 'admin') }}"
                :checked="false"
                tone="gray"
            />
        </div>
    </div>
{% endif %}
