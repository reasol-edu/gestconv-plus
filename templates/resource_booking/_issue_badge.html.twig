{#
   Marca de las incidencias de una reserva: un icono (ámbar si alguna sigue abierta, verde si todas están cerradas) y, si
   `label` es verdadero, su recuento en texto. Solo se pinta para quien puede ver alguna incidencia (el docente de la reserva,
   los responsables del tipo y la dirección); el resto del calendario no la ve. Variables: booking, label (opcional).
#}
{% set issues = booking_issues(booking) %}
{% if issues is not empty %}
    {% set open = booking_has_open_issue(booking) %}
    {% set text = (open ? 'booking.issue.badge_open' : 'booking.issue.badge_closed')|trans({'%count%': issues|length}, 'admin') %}
    <span class="inline-flex items-center gap-1 {{ open ? 'text-amber-600' : 'text-forest-600' }}" title="{{ text }}">
        {{ ux_icon(open ? 'heroicons:exclamation-triangle' : 'heroicons:check-circle', {class: 'h-4 w-4 shrink-0'}) }}
        {% if label ?? false %}<span class="text-xs font-semibold">{{ text }}</span>{% else %}<span class="sr-only">{{ text }}</span>{% endif %}
    </span>
{% endif %}
