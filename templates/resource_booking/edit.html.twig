{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'booking.edit'|trans({}, 'admin') }} · {{ app_name }}{% endblock %}

{% block content %}
<div class="px-6 py-8 max-w-3xl mx-auto space-y-6">

    <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 flex-wrap">
            {% include 'components/_breadcrumb_home.html.twig' %}
            <a href="{{ path('app_bookings_index') }}" class="hover:text-forest-600 transition-colors">{{ 'booking.title'|trans({}, 'admin') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
            <span aria-current="page" class="text-gray-700 font-medium">{{ 'booking.edit'|trans({}, 'admin') }}</span>
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ 'booking.edit'|trans({}, 'admin') }}</h1>
        {% if booking.rejected %}
            <p class="mt-2 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
                {{ 'booking.rejected_notice'|trans({}, 'admin') }}
                {% if booking.rejectionReason %}<span class="block mt-1"><strong>{{ 'booking.rejection_reason'|trans({}, 'admin') }}</strong> {{ booking.rejectionReason }}</span>{% endif %}
            </p>
        {% endif %}
    </div>

    <form method="post" class="space-y-6" data-controller="booking-form form-submit unsaved-changes">
        <input type="hidden" name="_token" value="{{ csrf_token('edit_resource_booking_' ~ booking.id) }}">

        {% include 'resource_booking/_form_fields.html.twig' with {mode: 'edit'} %}

        <div class="flex items-center justify-end gap-3">
            <a href="{{ path('app_bookings_show', {id: booking.id}) }}"
               class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm font-medium text-gray-700
                      hover:bg-gray-50 transition-colors">
                {{ 'booking.cancel'|trans({}, 'admin') }}
            </a>
            <button type="submit"
                    class="inline-flex items-center gap-2 rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white
                           hover:bg-forest-700 transition-colors shadow-xs">
                {{ ux_icon('heroicons:check', {class: 'h-4 w-4'}) }}
                {{ 'booking.save'|trans({}, 'admin') }}
            </button>
        </div>
    </form>

</div>
{% endblock %}

{% block javascripts %}{{ parent() }}
{% include 'resource_booking/_form_scripts.html.twig' %}
{% endblock %}
