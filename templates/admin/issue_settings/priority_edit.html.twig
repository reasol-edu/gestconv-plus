{% extends 'layouts/app.html.twig' %}

{% block title %}{{ priority.name }} · {{ 'issue_settings.title'|trans({}, 'admin') }} · {{ centre.name }} · {{ app_name }}{% endblock %}

{% block content %}
{% set inputClass = 'block w-full rounded-xl border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-sm text-gray-900 focus:border-forest-500 focus:bg-white focus:outline-none focus:ring-3 focus:ring-forest-500/20 transition-colors' %}
<div class="px-6 py-8 max-w-2xl mx-auto space-y-6">

    <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 flex-wrap">
            {% include 'components/_breadcrumb_home.html.twig' %}
            <a href="{{ path('app_centre_index', {centreId: centre.id}) }}" class="hover:text-forest-600 transition-colors">{{ 'educational_centre'|trans({}, 'navigation') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
            <a href="{{ path('app_centre_issue_settings', {centreId: centre.id}) }}" class="hover:text-forest-600 transition-colors">{{ 'issue_settings.title'|trans({}, 'admin') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ priority.name }}</h1>
    </div>

    <form method="post" class="space-y-6">
        <input type="hidden" name="_token" value="{{ csrf_token('edit_issue_priority_' ~ priority.id) }}">

        <div class="rounded-2xl border border-gray-200 bg-white shadow-xs p-6 space-y-5">
            <div>
                <label for="name" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'issue_settings.priorities.name'|trans({}, 'admin') }}</label>
                <input type="text" id="name" name="name" required maxlength="100" value="{{ priority.name }}" class="{{ inputClass }}">
            </div>

            <div>
                <label for="color" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'issue_settings.priorities.color'|trans({}, 'admin') }}</label>
                <input type="color" id="color" name="color" value="{{ priority.color }}" class="block h-10 w-16 cursor-pointer rounded-lg border border-gray-200 bg-white p-1">
            </div>

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                <div>
                    <label for="recommended_days" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'issue_settings.priorities.recommended'|trans({}, 'admin') }}</label>
                    <input type="number" id="recommended_days" name="recommended_days" min="0" max="365" value="{{ priority.recommendedDays }}" class="{{ inputClass }}">
                </div>
                <div>
                    <label for="max_days" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'issue_settings.priorities.max'|trans({}, 'admin') }}</label>
                    <input type="number" id="max_days" name="max_days" min="0" max="365" value="{{ priority.maxDays }}" class="{{ inputClass }}">
                </div>
            </div>
            <p class="text-xs text-gray-500">{{ 'issue_settings.priorities.deadlines_help'|trans({}, 'admin') }}</p>
        </div>

        <div class="flex items-center justify-end gap-3">
            <a href="{{ path('app_centre_issue_settings', {centreId: centre.id}) }}"
               class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors">
                {{ 'issue_settings.cancel'|trans({}, 'admin') }}
            </a>
            <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-forest-700 transition-colors shadow-xs">
                {{ ux_icon('heroicons:check', {class: 'h-4 w-4'}) }}{{ 'issue_settings.save'|trans({}, 'admin') }}
            </button>
        </div>
    </form>

</div>
{% endblock %}
