{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'issue_settings.import.title'|trans({}, 'admin') }} · {{ centre.name }} · {{ app_name }}{% endblock %}

{% block content %}
<div class="px-6 py-8 max-w-2xl mx-auto space-y-8">

    <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 flex-wrap">
            {% include 'components/_breadcrumb_home.html.twig' %}
            <a href="{{ path('app_centre_index', {centreId: centre.id}) }}" class="hover:text-forest-600 transition-colors">{{ 'educational_centre'|trans({}, 'navigation') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
            <a href="{{ path('app_centre_issue_settings', {centreId: centre.id}) }}" class="hover:text-forest-600 transition-colors">{{ 'issue_settings.title'|trans({}, 'admin') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ 'issue_settings.import.title'|trans({}, 'admin') }}</h1>
    </div>

    <div class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100">
            <h2 class="text-base font-semibold text-gray-900">{{ 'issue_settings.import.step_file'|trans({}, 'admin') }}</h2>
            <p class="mt-1 text-sm text-gray-500">{{ 'issue_settings.import.help'|trans({}, 'admin') }}</p>
        </div>
        <form method="post" enctype="multipart/form-data" class="px-6 py-6 space-y-6">
            <input type="hidden" name="_token" value="{{ csrf_token('import_issue_settings') }}">

            <div>
                <label for="json"
                       class="flex flex-col items-center justify-center gap-3 w-full rounded-xl border-2 border-dashed
                              border-gray-300 bg-gray-50 px-6 py-8 cursor-pointer
                              hover:border-forest-400 hover:bg-forest-50/40 transition-colors group">
                    {{ ux_icon('heroicons:arrow-up-tray', {class: 'h-8 w-8 text-gray-400 group-hover:text-forest-500 transition-colors'}) }}
                    <span class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2
                                 text-sm font-medium text-gray-700 shadow-xs group-hover:border-forest-300 group-hover:text-forest-700 transition-colors">
                        {{ 'issue_settings.import.choose_file'|trans({}, 'admin') }}
                    </span>
                    <span id="json-filename" class="text-xs text-gray-400">{{ 'issue_settings.import.no_file_chosen'|trans({}, 'admin') }}</span>
                </label>
                <input type="file" id="json" name="json" accept=".json,application/json" class="sr-only hidden"
                       onchange="document.getElementById('json-filename').textContent = this.files[0]?.name ?? '{{ 'issue_settings.import.no_file_chosen'|trans({}, 'admin')|e('js') }}'">
            </div>

            <div class="flex items-center justify-between pt-2">
                <a href="{{ path('app_centre_issue_settings', {centreId: centre.id}) }}" class="text-sm text-gray-500 hover:text-gray-700 transition-colors">{{ 'issue_settings.cancel'|trans({}, 'admin') }}</a>
                <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-forest-700 transition-colors shadow-xs">
                    {{ ux_icon('heroicons:eye', {class: 'h-4 w-4'}) }}{{ 'issue_settings.import.preview_button'|trans({}, 'admin') }}
                </button>
            </div>
        </form>
    </div>

</div>
{% endblock %}
