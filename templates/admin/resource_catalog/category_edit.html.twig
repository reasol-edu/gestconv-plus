{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'resource_catalog.category.edit_title'|trans({}, 'admin') }} · {{ centre.name }} · {{ app_name }}{% endblock %}

{% block content %}
<div class="px-6 py-8 max-w-2xl mx-auto space-y-6">

    <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 flex-wrap">
            {% include 'components/_breadcrumb_home.html.twig' %}
            <a href="{{ path('app_centre_resources_index', {centreId: centre.id}) }}" class="hover:text-forest-600 transition-colors">{{ 'resource_catalog.title'|trans({}, 'admin') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ 'resource_catalog.category.edit_title'|trans({}, 'admin') }}</h1>
    </div>

    <form method="post" action="{{ path('app_centre_resources_category_edit', {centreId: centre.id, id: category.id}) }}" class="space-y-6">
        <input type="hidden" name="_token" value="{{ csrf_token('edit_resource_category_' ~ category.id) }}">

        <div class="rounded-2xl border border-gray-200 bg-white shadow-xs p-6 space-y-5">
            <div>
                <label for="name" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'resource_catalog.category.name'|trans({}, 'admin') }}</label>
                <input type="text" id="name" name="name" required maxlength="200" value="{{ category.name }}"
                       class="block w-full rounded-xl border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-sm text-gray-900
                              focus:border-forest-500 focus:bg-white focus:outline-none focus:ring-3 focus:ring-forest-500/20 transition-colors">
            </div>

            <div>
                <label for="color" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'resource_catalog.category.color'|trans({}, 'admin') }}</label>
                <div class="flex items-center gap-4">
                    <input type="color" id="color" name="color" value="{{ category.color ?? '#6b7280' }}"
                           class="block h-10 w-16 cursor-pointer rounded-lg border border-gray-200 bg-white p-1">
                    <label class="inline-flex items-center gap-2 text-sm text-gray-600">
                        <input type="checkbox" name="no_color" value="1" {{ category.color is null ? 'checked' : '' }}
                               class="rounded border-gray-300 text-forest-600 focus:ring-forest-500">
                        {{ 'resource_catalog.category.no_color'|trans({}, 'admin') }}
                    </label>
                </div>
                <p class="mt-1.5 text-xs text-gray-500">{{ 'resource_catalog.category.color_help'|trans({}, 'admin') }}</p>
            </div>

            <div>
                <label for="managers" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'resource_catalog.category.managers'|trans({}, 'admin') }}</label>
                <select id="managers" name="managers[]" multiple class="w-full text-sm ts-local"
                        data-placeholder="{{ 'resource_catalog.category.managers_placeholder'|trans({}, 'admin')|e('html_attr') }}"
                        data-no-results="{{ 'school_event.field.groups_no_results'|trans({}, 'admin')|e('html_attr') }}">
                    {% for teacher in availableTeachers %}
                        <option value="{{ teacher.id.toRfc4122 }}" {{ teacher.id.toRfc4122 in selectedManagerIds ? 'selected' : '' }}>{{ teacher.name.full() }}</option>
                    {% endfor %}
                </select>
                <p class="mt-1.5 text-xs text-gray-500">{{ 'resource_catalog.category.managers_help'|trans({}, 'admin') }}</p>
            </div>
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white shadow-xs p-6 space-y-5">
            <h2 class="text-base font-semibold text-gray-900">{{ 'resource_catalog.category.rules'|trans({}, 'admin') }}</h2>

            <div>
                <p class="block text-sm font-medium text-gray-700 mb-2">{{ 'resource_catalog.category.who_books'|trans({}, 'admin') }}</p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <twig:Form:RadioCard
                        name="restricted"
                        value="0"
                        label="{{ 'resource_catalog.category.restricted_off'|trans({}, 'admin') }}"
                        help="{{ 'resource_catalog.category.restricted_off_help'|trans({}, 'admin') }}"
                        :checked="not category.restricted"
                    />
                    <twig:Form:RadioCard
                        name="restricted"
                        value="1"
                        label="{{ 'resource_catalog.category.restricted_on'|trans({}, 'admin') }}"
                        help="{{ 'resource_catalog.category.restricted_on_help'|trans({}, 'admin') }}"
                        :checked="category.restricted"
                        tone="gray"
                    />
                </div>
            </div>

            <div>
                <p class="block text-sm font-medium text-gray-700 mb-2">{{ 'resource_catalog.category.validation'|trans({}, 'admin') }}</p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <twig:Form:RadioCard
                        name="requires_approval"
                        value="0"
                        label="{{ 'resource_catalog.category.approval_off'|trans({}, 'admin') }}"
                        help="{{ 'resource_catalog.category.approval_off_help'|trans({}, 'admin') }}"
                        :checked="not category.requiresApproval"
                    />
                    <twig:Form:RadioCard
                        name="requires_approval"
                        value="1"
                        label="{{ 'resource_catalog.category.approval_on'|trans({}, 'admin') }}"
                        help="{{ 'resource_catalog.category.approval_on_help'|trans({}, 'admin') }}"
                        :checked="category.requiresApproval"
                        tone="gray"
                    />
                </div>
            </div>

            <div>
                <label for="max_advance_days" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'resource_catalog.category.max_advance'|trans({}, 'admin') }}</label>
                <input type="number" id="max_advance_days" name="max_advance_days" min="0" max="365" inputmode="numeric"
                       value="{{ category.maxAdvanceDays }}"
                       placeholder="{{ 'resource_catalog.category.max_advance_placeholder'|trans({}, 'admin') }}"
                       class="block w-40 rounded-xl border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-sm text-gray-900
                              focus:border-forest-500 focus:bg-white focus:outline-none focus:ring-3 focus:ring-forest-500/20 transition-colors">
                <p class="mt-1.5 text-xs text-gray-500">{{ 'resource_catalog.category.max_advance_help'|trans({}, 'admin') }}</p>
            </div>

            <div>
                <p class="block text-sm font-medium text-gray-700 mb-2">{{ 'resource_catalog.category.availability'|trans({}, 'admin') }}</p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <twig:Form:RadioCard
                        name="active"
                        value="1"
                        label="{{ 'resource_catalog.badge.active'|trans({}, 'admin') }}"
                        help="{{ 'resource_catalog.category.active_on'|trans({}, 'admin') }}"
                        :checked="category.active"
                    />
                    <twig:Form:RadioCard
                        name="active"
                        value="0"
                        label="{{ 'resource_catalog.badge.inactive'|trans({}, 'admin') }}"
                        help="{{ 'resource_catalog.category.active_off'|trans({}, 'admin') }}"
                        :checked="not category.active"
                        tone="gray"
                    />
                </div>
            </div>
        </div>

        <div class="flex items-center justify-end gap-3">
            <a href="{{ path('app_centre_resources_index', {centreId: centre.id}) }}"
               class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm font-medium text-gray-700
                      hover:bg-gray-50 transition-colors">
                {{ 'resource_catalog.cancel'|trans({}, 'admin') }}
            </a>
            <button type="submit"
                    class="inline-flex items-center gap-2 rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white
                           hover:bg-forest-700 transition-colors shadow-xs">
                {{ ux_icon('heroicons:check', {class: 'h-4 w-4'}) }}
                {{ 'resource_catalog.save'|trans({}, 'admin') }}
            </button>
        </div>
    </form>

</div>
{% endblock %}

{% block javascripts %}{{ parent() }}
<script type="module">
import TomSelect from 'tom-select';

const el = document.getElementById('managers');
if (el) {
    new TomSelect(el, {
        create:         false,
        maxOptions:     null,
        dropdownParent: 'body',
        placeholder:    el.dataset.placeholder ?? '',
        plugins:        ['remove_button', 'checkbox_options'],
        render: {
            no_results: () => `<div class="no-results px-3 py-2 text-sm">${el.dataset.noResults ?? ''}</div>`,
        },
    });
}
</script>
{% endblock %}
