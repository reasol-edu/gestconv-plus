{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'teachers.title'|trans({}, 'admin') }} · {{ app_name }}{% endblock %}

{% block content %}
<div class="px-6 py-8 max-w-7xl mx-auto space-y-8">

    <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1">
            {% include 'components/_breadcrumb_home.html.twig' %}
            <a href="{{ path('app_admin') }}" class="hover:text-forest-600 transition-colors">
                {{ 'dashboard.title'|trans({}, 'admin') }}
            </a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4'}) }}
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ 'teachers.title'|trans({}, 'admin') }}</h1>
    </div>

    {# ── Docentes ── #}
    <section>
        <div class="mb-3 flex items-center justify-between gap-4">
            <h2 class="flex items-center gap-2 text-lg font-semibold text-gray-900">
                {{ ux_icon('heroicons:users', {class: 'h-5 w-5 text-forest-600'}) }}
                {{ 'teachers.section_teachers'|trans({}, 'admin') }}
            </h2>
            <a href="{{ path('app_admin_teachers_new') }}"
               class="inline-flex items-center gap-2 rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white
                      hover:bg-forest-700 transition-colors shadow-xs">
                {{ ux_icon('heroicons:plus', {class: 'h-4 w-4'}) }}
                {{ 'teachers.new'|trans({}, 'admin') }}
            </a>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden">
            <twig:Admin:TeacherListComponent />
        </div>
    </section>

    {# ── Personal no docente: bloque aparte, con otro color, para no confundirlo con los docentes ── #}
    <section>
        <div class="mb-3 flex flex-wrap items-center justify-between gap-3 sm:gap-4">
            <div>
                <h2 class="flex items-center gap-2 text-lg font-semibold text-gray-900">
                    {{ ux_icon('heroicons:identification', {class: 'h-5 w-5 text-amber-600'}) }}
                    {{ 'teachers.section_non_teaching'|trans({}, 'admin') }}
                </h2>
                <p class="mt-0.5 text-sm text-gray-500">{{ 'teachers.section_non_teaching_help'|trans({}, 'admin') }}</p>
            </div>
            <a href="{{ path('app_admin_non_teaching_new') }}"
               class="inline-flex shrink-0 items-center gap-2 rounded-xl bg-amber-500 px-4 py-2.5 text-sm font-semibold text-white
                      hover:bg-amber-600 transition-colors shadow-xs">
                {{ ux_icon('heroicons:plus', {class: 'h-4 w-4'}) }}
                {{ 'teachers.new_non_teaching'|trans({}, 'admin') }}
            </a>
        </div>

        <div class="rounded-2xl border border-amber-200 bg-white shadow-xs overflow-hidden">
            {% if non_teaching is empty %}
                <div class="px-6 py-12 text-center">
                    {{ ux_icon('heroicons:identification', {class: 'mx-auto h-10 w-10 text-gray-300 mb-3'}) }}
                    <p class="text-sm text-gray-500">{{ 'teachers.non_teaching_empty'|trans({}, 'admin') }}</p>
                </div>
            {% else %}
                <div class="overflow-x-auto">
                <table class="table-cards w-full text-sm">
                    <thead>
                        <tr class="border-b border-amber-100 bg-amber-50">
                            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-amber-800 uppercase tracking-wider">{{ 'teachers.name'|trans({}, 'admin') }}</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-amber-800 uppercase tracking-wider">{{ 'teachers.username'|trans({}, 'admin') }}</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-amber-800 uppercase tracking-wider">{{ 'teachers.email'|trans({}, 'admin') }}</th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-amber-800 uppercase tracking-wider">{{ 'teachers.non_teaching_centres'|trans({}, 'admin') }}</th>
                            <th scope="col" class="px-6 py-3 text-right text-xs font-semibold text-amber-800 uppercase tracking-wider">{{ 'teachers.actions'|trans({}, 'admin') }}</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for account in non_teaching %}
                            {% set accountCentres = centres_by_account[account.id.toRfc4122] ?? [] %}
                            <tr class="hover:bg-gray-50 transition-colors">
                                <td data-label="{{ 'teachers.name'|trans({}, 'admin')|e('html_attr') }}" class="px-6 py-4">
                                    <a href="{{ path('app_admin_non_teaching_edit', {id: account.id}) }}"
                                       class="font-medium text-gray-900 hover:text-forest-700 transition-colors">{{ account.name.lastName }}, {{ account.name.firstName }}</a>
                                    {% if not account.active %}
                                        <span class="ml-2 inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/20">
                                            {{ 'teachers.badge.inactive'|trans({}, 'admin') }}
                                        </span>
                                    {% endif %}
                                </td>
                                <td data-label="{{ 'teachers.username'|trans({}, 'admin')|e('html_attr') }}" class="px-6 py-4 font-mono text-xs text-gray-600">{{ account.username }}</td>
                                <td data-label="{{ 'teachers.email'|trans({}, 'admin')|e('html_attr') }}" class="px-6 py-4 text-gray-500 text-xs">{{ account.email ?? '—' }}</td>
                                <td data-label="{{ 'teachers.non_teaching_centres'|trans({}, 'admin')|e('html_attr') }}" class="px-6 py-4">
                                    <div class="flex items-center gap-1.5 flex-wrap sm:justify-start justify-end">
                                        {% for centre in accountCentres %}
                                            <span class="inline-flex items-center rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700 ring-1 ring-inset ring-amber-600/20">{{ centre.name }}</span>
                                        {% else %}
                                            <span class="text-xs text-gray-400">{{ 'teachers.non_teaching_no_centres'|trans({}, 'admin') }}</span>
                                        {% endfor %}
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="flex flex-wrap items-center justify-end gap-2 [&_a]:whitespace-nowrap [&_button]:whitespace-nowrap">
                                        <a href="{{ path('app_admin_non_teaching_edit', {id: account.id}) }}"
                                           class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-medium
                                                  text-gray-700 hover:bg-gray-50 hover:border-gray-300 transition-colors">
                                            {{ ux_icon('heroicons:pencil-square', {class: 'h-3.5 w-3.5'}) }}
                                            {{ 'teachers.edit'|trans({}, 'admin') }}
                                        </a>
                                        {% if not is_granted('IS_IMPERSONATOR') and app.user and app.user.userIdentifier != account.username %}
                                            <a href="{{ path('app_dashboard') }}?_switch_user={{ account.username|e('url') }}"
                                               class="inline-flex items-center gap-1.5 rounded-lg border border-indigo-200 px-3 py-1.5 text-xs font-medium
                                                      text-indigo-600 hover:bg-indigo-50 hover:border-indigo-300 transition-colors">
                                                {{ ux_icon('heroicons:arrow-right-on-rectangle', {class: 'h-3.5 w-3.5'}) }}
                                                {{ 'teachers.switch_user'|trans({}, 'admin') }}
                                            </a>
                                        {% endif %}
                                        {% if account.email %}
                                            <form method="post" action="{{ path('app_admin_non_teaching_invite', {id: account.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('invite_non_teaching_admin_' ~ account.id) }}">
                                                <button type="submit"
                                                        class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-medium
                                                               text-gray-700 hover:bg-gray-50 hover:border-gray-300 transition-colors">
                                                    {{ ux_icon('heroicons:envelope', {class: 'h-3.5 w-3.5'}) }}
                                                    {{ 'non_teaching.action.invite'|trans({}, 'admin') }}
                                                </button>
                                            </form>
                                        {% endif %}
                                        <form method="post"
                                              action="{{ path('app_admin_non_teaching_delete', {id: account.id}) }}"
                                              class="js-confirm-form"
                                              data-confirm="{{ 'non_teaching.admin.delete_confirm'|trans({}, 'admin')|e('html_attr') }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_non_teaching_admin_' ~ account.id) }}">
                                            <button type="submit"
                                                    class="js-confirm-trigger inline-flex items-center gap-1.5 rounded-lg border border-red-200 px-3 py-1.5 text-xs font-medium
                                                           text-red-600 hover:bg-red-50 hover:border-red-300 transition-colors">
                                                {{ ux_icon('heroicons:trash', {class: 'h-3.5 w-3.5'}) }}
                                                {{ 'teachers.delete'|trans({}, 'admin') }}
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                </div>
            {% endif %}
        </div>
    </section>

</div>
{% endblock %}
