{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'daily_note_type.title'|trans({}, 'admin') }} · {{ centre.name }} · {{ app_name }}{% endblock %}

{% block content %}
<div class="px-6 py-8 max-w-5xl mx-auto space-y-6">

    <div class="flex items-start justify-between gap-4 flex-wrap">
        <div>
            <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 flex-wrap">
                {% include 'components/_breadcrumb_home.html.twig' %}
                <a href="{{ path('app_centre_index', {centreId: centre.id}) }}" class="hover:text-forest-600 transition-colors">{{ 'educational_centre'|trans({}, 'navigation') }}</a>
                {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
            </div>
            <h1 class="text-2xl font-bold text-gray-900">{{ 'daily_note_type.title'|trans({}, 'admin') }}</h1>
        </div>
        <div class="flex items-center gap-2 shrink-0">
            <a href="{{ path('app_centre_daily_note_types_import', {centreId: centre.id}) }}"
               class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700
                      hover:bg-gray-50 hover:border-gray-300 transition-colors shadow-xs">
                {{ ux_icon('heroicons:arrow-up-tray', {class: 'h-4 w-4'}) }}
                {{ 'daily_note_type.import.button'|trans({}, 'admin') }}
            </a>
            <a href="{{ path('app_centre_daily_note_types_export', {centreId: centre.id}) }}"
               class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-medium text-gray-700
                      hover:bg-gray-50 hover:border-gray-300 transition-colors shadow-xs">
                {{ ux_icon('heroicons:arrow-down-tray', {class: 'h-4 w-4'}) }}
                {{ 'daily_note_type.export.button'|trans({}, 'admin') }}
            </a>
        </div>
    </div>

    <div class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden">

        {% if types is empty %}
            <div class="px-6 py-8 text-center">
                <p class="text-sm text-gray-400">{{ 'daily_note_type.empty'|trans({}, 'admin') }}</p>
            </div>
        {% else %}
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
                            <th class="px-4 py-2 w-10"></th>
                            <th class="px-4 py-2">{{ 'daily_note_type.col.name'|trans({}, 'admin') }}</th>
                            <th class="px-4 py-2 w-56">{{ 'daily_note_type.field.occurrences_for_report'|trans({}, 'admin') }}</th>
                            <th class="px-4 py-2 w-40">{{ 'daily_note_type.col.expiry_days'|trans({}, 'admin') }}</th>
                            <th class="px-4 py-2 w-28"></th>
                            <th class="px-4 py-2 w-32"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for i, type in types %}
                            <tr class="hover:bg-gray-50 transition-colors {{ not type.active ? 'opacity-50' : '' }}">
                                <td class="px-4 py-3 w-10">
                                    <div class="flex flex-col gap-0.5">
                                        {% if i > 0 %}
                                            <form method="post" action="{{ path('app_centre_daily_note_types_move_up', {centreId: centre.id, id: type.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('move_daily_note_type_' ~ type.id) }}">
                                                <button type="submit" class="p-0.5 rounded text-gray-400 hover:text-gray-700 hover:bg-gray-100 transition-colors" title="{{ 'ui.move_up'|trans }}">
                                                    {{ ux_icon('heroicons:chevron-up', {class: 'h-3.5 w-3.5'}) }}
                                                </button>
                                            </form>
                                        {% else %}
                                            <span class="p-0.5 text-transparent">{{ ux_icon('heroicons:chevron-up', {class: 'h-3.5 w-3.5'}) }}</span>
                                        {% endif %}
                                        {% if i < types|length - 1 %}
                                            <form method="post" action="{{ path('app_centre_daily_note_types_move_down', {centreId: centre.id, id: type.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('move_daily_note_type_' ~ type.id) }}">
                                                <button type="submit" class="p-0.5 rounded text-gray-400 hover:text-gray-700 hover:bg-gray-100 transition-colors" title="{{ 'ui.move_down'|trans }}">
                                                    {{ ux_icon('heroicons:chevron-down', {class: 'h-3.5 w-3.5'}) }}
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                                <td class="px-4 py-3 text-gray-800 flex-1">{{ type.name }}</td>
                                <td class="px-4 py-3 text-gray-600">
                                    {% if type.occurrencesForReport > 0 %}
                                        {{ 'daily_note_type.occurrences_summary'|trans({'%count%': type.occurrencesForReport}, 'admin') }}
                                    {% else %}
                                        <span class="text-gray-400">{{ 'daily_note_type.occurrences_none'|trans({}, 'admin') }}</span>
                                    {% endif %}
                                </td>
                                <td class="px-4 py-3 text-gray-600">
                                    {% if type.expiryDays > 0 %}
                                        {{ 'daily_note_type.expiry_summary'|trans({'%count%': type.expiryDays}, 'admin') }}
                                    {% else %}
                                        <span class="text-gray-400">{{ 'daily_note_type.expiry_none'|trans({}, 'admin') }}</span>
                                    {% endif %}
                                </td>
                                <td class="px-4 py-3 w-28">
                                    <form method="post" action="{{ path('app_centre_daily_note_types_toggle_active', {centreId: centre.id, id: type.id}) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_daily_note_type_' ~ type.id) }}">
                                        <button type="submit"
                                                class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium cursor-pointer transition-colors
                                                       {{ type.active ? 'bg-green-100 text-green-700 hover:bg-green-200' : 'bg-gray-100 text-gray-500 hover:bg-gray-200' }}">
                                            {{ type.active ? 'daily_note_type.badge.active'|trans({}, 'admin') : 'daily_note_type.badge.inactive'|trans({}, 'admin') }}
                                        </button>
                                    </form>
                                </td>
                                <td class="px-4 py-3 w-32">
                                    <div class="flex items-center justify-end gap-2">
                                        <a href="{{ path('app_centre_daily_note_types_edit', {centreId: centre.id, id: type.id}) }}"
                                           class="inline-flex items-center gap-1 rounded-lg border border-gray-200 px-2.5 py-1.5 text-xs font-medium text-gray-700
                                                  hover:bg-gray-50 hover:border-gray-300 transition-colors">
                                            {{ ux_icon('heroicons:pencil-square', {class: 'h-3.5 w-3.5'}) }}
                                            {{ 'ui.edit'|trans }}
                                        </a>
                                        <form method="post" action="{{ path('app_centre_daily_note_types_delete', {centreId: centre.id, id: type.id}) }}"
                                              class="js-confirm-form"
                                              data-confirm="{{ 'daily_note_type.delete_confirm'|trans({}, 'admin')|e('html_attr') }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_daily_note_type_' ~ type.id) }}">
                                            <button type="submit"
                                                    class="js-confirm-trigger inline-flex items-center gap-1 rounded-lg border border-red-200 px-2.5 py-1.5 text-xs font-medium
                                                           text-red-600 hover:bg-red-50 hover:border-red-300 transition-colors">
                                                {{ ux_icon('heroicons:trash', {class: 'h-3.5 w-3.5'}) }}
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

        {# ── Formulario para nuevo tipo ─────────────────────────────────── #}
        <div class="border-t border-gray-100 px-5 py-4 bg-gray-50/60">
            <form method="post" action="{{ path('app_centre_daily_note_types_create', {centreId: centre.id}) }}"
                  class="flex flex-wrap items-end gap-3">
                <input type="hidden" name="_token" value="{{ csrf_token('new_daily_note_type_' ~ centre.id) }}">
                <div class="flex-1 min-w-48">
                    <label class="block text-xs font-medium text-gray-600 mb-1">{{ 'daily_note_type.field.name'|trans({}, 'admin') }}</label>
                    <input type="text" name="name" required maxlength="200"
                           class="block w-full rounded-xl border border-gray-200 bg-white px-3.5 py-2 text-sm text-gray-900
                                  focus:border-forest-500 focus:outline-none focus:ring-3 focus:ring-forest-500/20 transition-colors">
                </div>
                <div class="w-48">
                    <label class="block text-xs font-medium text-gray-600 mb-1">{{ 'daily_note_type.field.occurrences_for_report'|trans({}, 'admin') }}</label>
                    <input type="number" name="occurrences_for_report" min="0" step="1" value="0"
                           class="block w-full rounded-xl border border-gray-200 bg-white px-3.5 py-2 text-sm text-gray-900
                                  focus:border-forest-500 focus:outline-none focus:ring-3 focus:ring-forest-500/20 transition-colors">
                </div>
                <div class="w-40">
                    <label class="block text-xs font-medium text-gray-600 mb-1">{{ 'daily_note_type.field.expiry_days'|trans({}, 'admin') }}</label>
                    <input type="number" name="expiry_days" min="0" step="1" value="0"
                           class="block w-full rounded-xl border border-gray-200 bg-white px-3.5 py-2 text-sm text-gray-900
                                  focus:border-forest-500 focus:outline-none focus:ring-3 focus:ring-forest-500/20 transition-colors">
                </div>
                <div class="shrink-0">
                    <button type="submit"
                            class="inline-flex items-center gap-1.5 rounded-xl bg-forest-600 px-3.5 py-2 text-sm font-semibold text-white
                                   hover:bg-forest-700 transition-colors shadow-xs">
                        {{ ux_icon('heroicons:plus', {class: 'h-4 w-4'}) }}
                        {{ 'daily_note_type.new'|trans({}, 'admin') }}
                    </button>
                </div>
            </form>
            <p class="mt-2 text-xs text-gray-400">{{ 'daily_note_type.field.occurrences_help'|trans({}, 'admin') }}</p>
        </div>

    </div>

</div>
{% endblock %}
