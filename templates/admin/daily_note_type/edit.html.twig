{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'daily_note_type.title'|trans({}, 'admin') }} · {{ centre.name }} · {{ app_name }}{% endblock %}

{% block content %}
<div class="px-6 py-8 max-w-2xl mx-auto space-y-6">

    <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 flex-wrap">
            {% include 'components/_breadcrumb_home.html.twig' %}
            <a href="{{ path('app_centre_daily_note_types_index', {centreId: centre.id}) }}" class="hover:text-forest-600 transition-colors">{{ 'daily_note_type.title'|trans({}, 'admin') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ 'daily_note_type.edit_title'|trans({}, 'admin') }}</h1>
    </div>

    <div class="rounded-2xl border border-gray-200 bg-white shadow-xs p-6">
        <form method="post" action="{{ path('app_centre_daily_note_types_edit', {centreId: centre.id, id: type.id}) }}" class="space-y-5">
            <input type="hidden" name="_token" value="{{ csrf_token('edit_daily_note_type_' ~ type.id) }}">

            <div>
                <label for="name" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'daily_note_type.field.name'|trans({}, 'admin') }}</label>
                <input type="text" id="name" name="name" required maxlength="200"
                       value="{{ type.name }}"
                       class="block w-full rounded-xl border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-sm text-gray-900
                              focus:border-forest-500 focus:bg-white focus:outline-none focus:ring-3 focus:ring-forest-500/20 transition-colors">
            </div>

            <div>
                <label for="occurrences_for_report" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'daily_note_type.field.occurrences_for_report'|trans({}, 'admin') }}</label>
                <input type="number" id="occurrences_for_report" name="occurrences_for_report" min="0" step="1"
                       value="{{ type.occurrencesForReport }}"
                       class="block w-40 rounded-xl border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-sm text-gray-900
                              focus:border-forest-500 focus:bg-white focus:outline-none focus:ring-3 focus:ring-forest-500/20 transition-colors">
                <p class="mt-1.5 text-xs text-gray-500">{{ 'daily_note_type.field.occurrences_help'|trans({}, 'admin') }}</p>
            </div>

            <div>
                <label for="expiry_days" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'daily_note_type.field.expiry_days'|trans({}, 'admin') }}</label>
                <input type="number" id="expiry_days" name="expiry_days" min="0" step="1"
                       value="{{ type.expiryDays }}"
                       class="block w-40 rounded-xl border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-sm text-gray-900
                              focus:border-forest-500 focus:bg-white focus:outline-none focus:ring-3 focus:ring-forest-500/20 transition-colors">
                <p class="mt-1.5 text-xs text-gray-500">{{ 'daily_note_type.field.expiry_days_help'|trans({}, 'admin') }}</p>
            </div>

            <div>
                <p class="block text-sm font-medium text-gray-700 mb-2">{{ 'daily_note_type.field.active'|trans({}, 'admin') }}</p>
                <div class="grid grid-cols-2 gap-3">
                    <twig:Form:RadioCard
                        name="active"
                        value="1"
                        label="{{ 'daily_note_type.badge.active'|trans({}, 'admin') }}"
                        help="{{ 'daily_note_type.field.active_on'|trans({}, 'admin') }}"
                        :checked="type.active"
                    />
                    <twig:Form:RadioCard
                        name="active"
                        value="0"
                        label="{{ 'daily_note_type.badge.inactive'|trans({}, 'admin') }}"
                        help="{{ 'daily_note_type.field.active_off'|trans({}, 'admin') }}"
                        :checked="not type.active"
                        tone="gray"
                    />
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-2">
                <a href="{{ path('app_centre_daily_note_types_index', {centreId: centre.id}) }}"
                   class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm font-medium text-gray-700
                          hover:bg-gray-50 transition-colors">
                    {{ 'daily_note_type.cancel'|trans({}, 'admin') }}
                </a>
                <button type="submit"
                        class="inline-flex items-center gap-2 rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white
                               hover:bg-forest-700 transition-colors shadow-xs">
                    {{ ux_icon('heroicons:check', {class: 'h-4 w-4'}) }}
                    {{ 'daily_note_type.save'|trans({}, 'admin') }}
                </button>
            </div>
        </form>
    </div>

</div>
{% endblock %}
