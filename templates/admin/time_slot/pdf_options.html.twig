{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'time_slot.pdf_options.title'|trans({}, 'admin') }} · {{ centre.name }} · {{ app_name }}{% endblock %}

{% block content %}
<div class="px-6 py-8 max-w-2xl mx-auto space-y-8">

    <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 flex-wrap">
            {% include 'components/_breadcrumb_home.html.twig' %}
            <a href="{{ path('app_centre_index', {centreId: centre.id}) }}" class="hover:text-forest-600 transition-colors">{{ 'educational_centre'|trans({}, 'navigation') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
            <a href="{{ path('app_centre_time_slots_index', {centreId: centre.id}) }}" class="hover:text-forest-600 transition-colors">{{ 'time_slot.title'|trans({}, 'admin') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ 'time_slot.pdf_options.title'|trans({}, 'admin') }}</h1>
    </div>

    {% if report.rows is empty %}
        <div class="rounded-2xl border border-gray-200 bg-white shadow-xs px-6 py-10 text-center">
            <p class="text-sm text-gray-500">{{ 'time_slot.col.empty'|trans({}, 'admin') }}</p>
            <a href="{{ path('app_centre_time_slots_index', {centreId: centre.id}) }}"
               class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-forest-700 hover:text-forest-900 transition-colors">
                {{ 'time_slot.pdf_options.cancel'|trans({}, 'admin') }}
            </a>
        </div>
    {% else %}
        <form method="get" action="{{ path('app_centre_time_slots_pdf', {centreId: centre.id}) }}" target="_blank"
              data-controller="report-selection form-submit" class="space-y-6">

            <div data-report-selection-target="error" class="hidden rounded-xl px-4 py-3 text-sm font-medium bg-red-50 text-red-800 border border-red-200">
                {{ 'time_slot.pdf_options.error_no_selection'|trans({}, 'admin') }}
            </div>

            <div class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden">
                <div class="px-6 py-4 border-b border-gray-100">
                    <h2 class="text-base font-semibold text-gray-900">{{ 'time_slot.pdf_options.time_slots_label'|trans({}, 'admin') }}</h2>
                </div>
                <div class="divide-y divide-gray-100">
                    {% for row in report.rows %}
                        <label class="flex items-center gap-3 px-6 py-3 text-sm cursor-pointer hover:bg-gray-50">
                            <input type="checkbox" name="time_slots[]" value="{{ row.key }}" checked
                                   data-report-selection-target="checkbox"
                                   class="h-4 w-4 shrink-0 rounded border-gray-300 text-forest-600 focus:ring-forest-500">
                            <span class="font-medium text-gray-900">{{ row.label }}</span>
                            <span class="text-gray-400">{{ row.startTime|date('format.time'|trans) }} – {{ row.endTime|date('format.time'|trans) }}</span>
                        </label>
                    {% endfor %}
                </div>
            </div>

            <div class="rounded-2xl border border-gray-200 bg-white shadow-xs px-6 py-5">
                <label for="text_size" class="block text-sm font-medium text-gray-700 mb-1.5">
                    {{ 'time_slot.pdf_options.text_size_label'|trans({}, 'admin') }}
                </label>
                <select id="text_size" name="text_size"
                        class="block w-full max-w-xs rounded-xl border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-sm text-gray-900
                               focus:border-forest-500 focus:bg-white focus:outline-none focus:ring-3 focus:ring-forest-500/20 transition-colors">
                    {% for size in textSizes %}
                        <option value="{{ size }}" {{ size == 100 ? 'selected' : '' }}>{{ size }}%</option>
                    {% endfor %}
                </select>
            </div>

            <div class="flex items-center justify-between pt-2">
                <a href="{{ path('app_centre_time_slots_index', {centreId: centre.id}) }}"
                   class="text-sm text-gray-500 hover:text-gray-700 transition-colors">
                    {{ 'time_slot.pdf_options.cancel'|trans({}, 'admin') }}
                </a>
                <button type="submit"
                        class="inline-flex items-center gap-2 rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-forest-700 transition-colors shadow-xs">
                    {{ ux_icon('heroicons:document-text', {class: 'h-4 w-4'}) }}
                    {{ 'time_slot.pdf_options.submit'|trans({}, 'admin') }}
                </button>
            </div>
        </form>
    {% endif %}

</div>
{% endblock %}
