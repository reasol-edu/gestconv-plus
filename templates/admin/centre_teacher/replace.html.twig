{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'centre_teachers.replace.title'|trans({}, 'admin') }} · {{ centre.name }} · {{ app_name }}{% endblock %}

{% block content %}
<div class="px-6 py-8 max-w-2xl mx-auto">

    <div class="mb-6">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 flex-wrap">
            {% include 'components/_breadcrumb_home.html.twig' %}
            <a href="{{ path('app_centre_index', {centreId: centre.id}) }}" class="hover:text-forest-600 transition-colors">{{ 'educational_centre'|trans({}, 'navigation') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
            <a href="{{ path('app_centre_teachers_index', {centreId: centre.id}) }}" class="hover:text-forest-600 transition-colors">{{ 'centre_teachers.title'|trans({}, 'admin') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ 'centre_teachers.replace.title'|trans({}, 'admin') }}</h1>
        <p class="mt-1 text-sm text-gray-500">{{ teacher.name.lastName }}, {{ teacher.name.firstName }} · {{ centre.activeAcademicYear.name }}</p>
    </div>

    <div class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden">
        <form method="post" class="px-6 py-6 space-y-5">
            <input type="hidden" name="_token" value="{{ csrf_token('replace_centre_teacher_' ~ teacher.id) }}">

            <p class="text-sm text-gray-600">
                {{ 'centre_teachers.replace.intro'|trans({'%name%': teacher.name.full()}, 'admin') }}
            </p>

            <div>
                <label for="teacher-replaces" class="block text-sm font-medium text-gray-700 mb-1.5">
                    {{ 'centre_teachers.replace.label'|trans({}, 'admin') }} <span class="text-red-500" aria-hidden="true">*</span>
                </label>
                {% include 'admin/centre_teacher/_replaces_select.html.twig' with {name: 'replaces', id: 'teacher-replaces', year: centre.activeAcademicYear} only %}
                {% if error %}
                    <p class="mt-1.5 text-xs text-red-600">{{ error }}</p>
                {% endif %}
                <p class="mt-1.5 text-xs text-gray-500">{{ 'centre_teachers.replaces.help'|trans({}, 'admin') }}</p>
            </div>

            <div class="flex items-center justify-end gap-3 pt-2">
                <a href="{{ path('app_centre_teachers_index', {centreId: centre.id}) }}"
                   class="rounded-xl border border-gray-200 px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50 transition-colors">
                    {{ 'teacher.cancel'|trans({}, 'admin') }}
                </a>
                <button type="submit"
                        class="inline-flex items-center gap-2 rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white
                               hover:bg-forest-700 transition-colors shadow-xs">
                    {{ ux_icon('heroicons:arrows-right-left', {class: 'h-4 w-4'}) }}
                    {{ 'centre_teachers.replace.submit'|trans({}, 'admin') }}
                </button>
            </div>
        </form>
    </div>

</div>
{% endblock %}
