{% extends 'email/_layout.html.twig' %}

{% block content %}
<p style="margin: 0 0 16px;">
    {{ 'emails.greeting'|trans({'%name%': teacher.name.firstName}, 'emails') }}
</p>
<p style="margin: 0 0 24px;">
    {{ (transPrefix ~ '.intro')|trans(params, 'emails') }}
</p>
{% for section in sections %}
<p style="margin: 0 0 8px; font-weight: 600; color: #374151; font-size: 13px;">
    {{ section.title }}
</p>
<ul style="margin: 0 0 24px; padding-left: 0; list-style: none; color: #374151; font-size: 13px;">
    {% for line in section.lines %}
    <li style="margin: 0 0 8px; padding: 10px 16px; background-color: #f9fafb; border-left: 3px solid #677dae;">
        {% if line.url %}
        <a href="{{ line.url }}" style="color: #576490; font-weight: 600; text-decoration: none;">{{ line.text }}</a>
        {% else %}
        {{ line.text }}
        {% endif %}
        {% if line.times > 1 %}
        <span style="color: #9ca3af;">{{ 'emails.digest.times'|trans({'%count%': line.times}, 'emails') }}</span>
        {% endif %}
    </li>
    {% endfor %}
</ul>
{% endfor %}
{% endblock %}
