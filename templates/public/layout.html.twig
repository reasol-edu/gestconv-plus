{% extends 'base.html.twig' %}

{% block title %}{{ 'public_tasks.page_title'|trans({}, 'messages') }} · {{ app_name }}{% endblock %}

{% block javascripts %}
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
    {{ parent() }}
{% endblock %}

{% block body %}
<main class="min-h-screen bg-gray-50 px-4 py-8 sm:py-12">
    <div class="mx-auto w-full max-w-2xl">
        <div class="flex items-center gap-3 mb-8">
            <img src="{{ asset('static/logo.svg') }}" alt="" class="w-12 h-12 shrink-0">
            <span class="text-forest-900 text-lg font-semibold">{{ app_name }}</span>
        </div>
        {% block public_content %}{% endblock %}
    </div>
</main>
{% endblock %}
