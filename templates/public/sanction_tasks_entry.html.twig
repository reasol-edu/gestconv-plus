{% extends 'public/layout.html.twig' %}

{% block public_content %}
<div class="rounded-2xl border border-gray-200 bg-white p-6 shadow-xs sm:p-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-1">{{ 'public_tasks.entry.title'|trans({}, 'messages') }}</h1>
    <p class="text-sm leading-relaxed text-gray-500 mb-6">{{ 'public_tasks.entry.intro'|trans({}, 'messages') }}</p>

    {% if error %}
        <div role="alert" class="mb-6 flex items-start gap-3 rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm text-red-700">
            {{ ux_icon('heroicons:exclamation-triangle', {class: 'h-5 w-5 shrink-0 mt-0.5'}) }}
            <span>{{ 'public_tasks.entry.error'|trans({}, 'messages') }}</span>
        </div>
    {% endif %}

    <form method="post" action="{{ path('app_public_tasks_entry') }}" novalidate class="space-y-5">
        <div>
            <label for="code" class="block text-sm font-medium text-gray-700 mb-1.5">{{ 'public_tasks.entry.label'|trans({}, 'messages') }}</label>
            <input id="code" type="text" name="code" value="{{ input }}" required autofocus
                   autocomplete="off" autocapitalize="characters" autocorrect="off" spellcheck="false" inputmode="text"
                   maxlength="20" placeholder="XXXXX-XXXXX"
                   data-controller="code-input"
                   data-action="input->code-input#format"
                   class="block w-full rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 font-mono text-lg uppercase tracking-widest text-gray-900
                          placeholder-gray-300 transition-all duration-150
                          focus:border-forest-500 focus:bg-white focus:ring-3 focus:ring-forest-500/20 focus:outline-none">
            <p class="mt-1.5 text-xs text-gray-500">{{ 'public_tasks.entry.hint'|trans({}, 'messages') }}</p>
        </div>
        <button type="submit"
                class="w-full rounded-xl bg-forest-600 px-4 py-3 text-sm font-semibold text-white transition-colors duration-150
                       hover:bg-forest-700 active:bg-forest-800 focus:outline-none focus:ring-3 focus:ring-forest-500/40">
            {{ 'public_tasks.entry.submit'|trans({}, 'messages') }}
        </button>
    </form>
</div>
{% endblock %}
