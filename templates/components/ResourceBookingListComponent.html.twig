{% import 'components/_pagination_live.html.twig' as pager %}
{% set selectClass = 'rounded-lg border border-gray-200 bg-white py-2 pl-3 pr-8 text-sm text-gray-700 focus:border-forest-500 focus:outline-none focus:ring-3 focus:ring-forest-500/20 transition-colors shrink-0' %}
<div {{ attributes }}>
    {% if centre.activeAcademicYear is null %}
        <div class="px-6 py-16 text-center">
            {{ ux_icon('heroicons:exclamation-circle', {class: 'mx-auto h-10 w-10 text-amber-300 mb-3'}) }}
            <p class="text-sm text-gray-500">{{ 'booking.no_active_year'|trans({}, 'admin') }}</p>
        </div>
    {% else %}
        {% set pagination = this.pagination %}

        {# Barra de filtros #}
        <div class="px-6 py-3 border-b border-gray-100 bg-gray-50/50 flex flex-wrap items-end gap-3">
            {% if this.canSeeOthers %}
                <label class="block">
                    <span class="mb-1 block text-xs font-medium text-gray-500">{{ 'booking.filter.scope'|trans({}, 'admin') }}</span>
                    <select data-model="norender|scope" data-action="change->live#action" data-live-action-param="resetPage" class="{{ selectClass }}">
                        <option value="mine" {{ scope == 'mine' ? 'selected' : '' }}>{{ 'booking.filter.scope_mine'|trans({}, 'admin') }}</option>
                        <option value="managed" {{ scope == 'managed' ? 'selected' : '' }}>{{ 'booking.filter.scope_managed'|trans({}, 'admin') }}</option>
                    </select>
                </label>
            {% endif %}

            <label class="block">
                <span class="mb-1 block text-xs font-medium text-gray-500">{{ 'booking.filter.from'|trans({}, 'admin') }}</span>
                <input type="date" data-model="norender|dateFrom" data-action="change->live#action" data-live-action-param="resetPage" value="{{ dateFrom }}" class="{{ selectClass }}">
            </label>
            <label class="block">
                <span class="mb-1 block text-xs font-medium text-gray-500">{{ 'booking.filter.to'|trans({}, 'admin') }}</span>
                <input type="date" data-model="norender|dateTo" data-action="change->live#action" data-live-action-param="resetPage" value="{{ dateTo }}" class="{{ selectClass }}">
            </label>

            <label class="block">
                <span class="mb-1 block text-xs font-medium text-gray-500">{{ 'booking.filter.category'|trans({}, 'admin') }}</span>
                <select data-model="norender|categoryId" data-action="change->live#action" data-live-action-param="resetPage" class="{{ selectClass }}">
                    <option value="">{{ 'booking.filter.all_categories'|trans({}, 'admin') }}</option>
                    {% for category in this.availableCategories %}
                        <option value="{{ category.id.toRfc4122 }}" {{ categoryId == category.id.toRfc4122 ? 'selected' : '' }}>{{ category.name }}</option>
                    {% endfor %}
                </select>
            </label>

            <label class="block">
                <span class="mb-1 block text-xs font-medium text-gray-500">{{ 'booking.filter.resource'|trans({}, 'admin') }}</span>
                <select data-model="norender|resourceId" data-action="change->live#action" data-live-action-param="resetPage" class="{{ selectClass }}">
                    <option value="">{{ 'booking.filter.all_resources'|trans({}, 'admin') }}</option>
                    {% for resource in this.availableResources %}
                        <option value="{{ resource.id.toRfc4122 }}" {{ resourceId == resource.id.toRfc4122 ? 'selected' : '' }}>{{ resource.name }}</option>
                    {% endfor %}
                </select>
            </label>

            {% if this.availableGroups is not empty %}
                <label class="block">
                    <span class="mb-1 block text-xs font-medium text-gray-500">{{ 'booking.filter.group'|trans({}, 'admin') }}</span>
                    <select data-model="norender|groupId" data-action="change->live#action" data-live-action-param="resetPage" class="{{ selectClass }}">
                        <option value="">{{ 'booking.filter.all_groups'|trans({}, 'admin') }}</option>
                        {% for group in this.availableGroups %}
                            <option value="{{ group.id.toRfc4122 }}" {{ groupId == group.id.toRfc4122 ? 'selected' : '' }}>{{ group.name }}</option>
                        {% endfor %}
                    </select>
                </label>
            {% endif %}

            {% if this.canSeeOthers and scope == 'managed' %}
                <label class="block">
                    <span class="mb-1 block text-xs font-medium text-gray-500">{{ 'booking.filter.teacher'|trans({}, 'admin') }}</span>
                    <select data-model="norender|teacherId" data-action="change->live#action" data-live-action-param="resetPage" class="{{ selectClass }}">
                        <option value="">{{ 'booking.filter.all_teachers'|trans({}, 'admin') }}</option>
                        {% for teacher in this.availableTeachers %}
                            <option value="{{ teacher.id.toRfc4122 }}" {{ teacherId == teacher.id.toRfc4122 ? 'selected' : '' }}>{{ teacher.name.full() }}</option>
                        {% endfor %}
                    </select>
                </label>
            {% endif %}

            <label class="block">
                <span class="mb-1 block text-xs font-medium text-gray-500">{{ 'booking.filter.status'|trans({}, 'admin') }}</span>
                <select data-model="norender|status" data-action="change->live#action" data-live-action-param="resetPage" class="{{ selectClass }}">
                    <option value="">{{ 'booking.filter.all_statuses'|trans({}, 'admin') }}</option>
                    {% for option in this.statuses %}
                        <option value="{{ option.value }}" {{ status == option.value ? 'selected' : '' }}>{{ ('booking.status.' ~ option.value)|trans({}, 'admin') }}</option>
                    {% endfor %}
                </select>
            </label>

            <svg data-loading class="hidden h-4 w-4 text-forest-500 animate-spin shrink-0 ml-auto" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 22 6.477 22 12h-4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/>
            </svg>
        </div>

        <div data-loading="addClass(opacity-50 pointer-events-none animate-pulse)" class="transition-opacity">
        {% if pagination.totalItems == 0 %}
            <div class="px-6 py-16 text-center">
                {{ ux_icon('heroicons:calendar-days', {class: 'mx-auto h-10 w-10 text-gray-300 mb-3'}) }}
                <p class="text-sm text-gray-500">{{ (this.hasActiveFilters ? 'booking.list.empty_filtered' : 'booking.list.empty')|trans({}, 'admin') }}</p>
            </div>
        {% else %}
            <div class="overflow-x-auto">
            <table class="table-cards w-full text-sm">
                <thead>
                    <tr class="border-b border-gray-100 bg-gray-50">
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ 'booking.col.date'|trans({}, 'admin') }}</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ 'booking.col.time_slot'|trans({}, 'admin') }}</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ 'booking.col.resource'|trans({}, 'admin') }}</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ 'booking.col.teacher'|trans({}, 'admin') }}</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ 'booking.col.groups'|trans({}, 'admin') }}</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ 'booking.col.status'|trans({}, 'admin') }}</th>
                        <th scope="col" class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ 'booking.col.actions'|trans({}, 'admin') }}</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for booking in pagination.items %}
                        <tr class="hover:bg-gray-50 transition-colors {{ booking.rejected ? 'opacity-60' : '' }}">
                            <td data-label="{{ 'booking.col.date'|trans({}, 'admin')|e('html_attr') }}" class="px-6 py-4 text-gray-700 whitespace-nowrap">
                                {{ ('weekday.' ~ booking.date|date('N'))|trans({}, 'calendar') }} {{ booking.date|date('format.date'|trans) }}
                            </td>
                            <td data-label="{{ 'booking.col.time_slot'|trans({}, 'admin')|e('html_attr') }}" class="px-6 py-4 text-gray-600">
                                {% for slot in booking.timeSlotsOrdered %}
                                    <span class="block whitespace-nowrap">{{ slot.name }} <span class="text-xs tabular-nums text-gray-400">{{ slot.startTime|date('H:i') }}–{{ slot.endTime|date('H:i') }}</span></span>
                                {% endfor %}
                            </td>
                            <td data-label="{{ 'booking.col.resource'|trans({}, 'admin')|e('html_attr') }}" class="px-6 py-4">
                                <a href="{{ path('app_bookings_show', {id: booking.id}) }}" class="font-medium text-gray-900 hover:text-forest-700 transition-colors">{{ booking.resource.name }}</a>
                                <div class="mt-1"><twig:EventTypeBadge :type="booking.resource.category" /></div>
                            </td>
                            <td data-label="{{ 'booking.col.teacher'|trans({}, 'admin')|e('html_attr') }}" class="px-6 py-4 text-gray-700">{{ booking.teacher.name.full() }}</td>
                            <td data-label="{{ 'booking.col.groups'|trans({}, 'admin')|e('html_attr') }}" class="px-6 py-4">
                                <div class="flex flex-wrap gap-1">
                                    {% for group in booking.groups %}<twig:GroupChip :group="group" />{% endfor %}
                                </div>
                            </td>
                            <td data-label="{{ 'booking.col.status'|trans({}, 'admin')|e('html_attr') }}" class="px-6 py-4">
                                {% include 'resource_booking/_status_badge.html.twig' with {booking: booking} only %}
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex items-center justify-end gap-2">
                                    {% if booking.pending and is_granted('resource_booking.manage', booking) %}
                                        <form method="post" action="{{ path('app_bookings_approve', {id: booking.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('resolve_resource_booking_' ~ booking.id) }}">
                                            <input type="hidden" name="back" value="list">
                                            <button type="submit"
                                                    class="inline-flex items-center gap-1.5 rounded-lg border border-forest-200 px-3 py-1.5 text-xs font-medium text-forest-700 hover:bg-forest-50 transition-colors">
                                                {{ ux_icon('heroicons:check', {class: 'h-3.5 w-3.5'}) }}{{ 'booking.validate.approve'|trans({}, 'admin') }}
                                            </button>
                                        </form>
                                    {% endif %}
                                    <a href="{{ path('app_bookings_show', {id: booking.id}) }}"
                                       class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50 hover:border-gray-300 transition-colors">
                                        {{ ux_icon('heroicons:eye', {class: 'h-3.5 w-3.5'}) }}{{ 'booking.action.view'|trans({}, 'admin') }}
                                    </a>
                                    {% if is_granted('resource_booking.edit', booking) %}
                                        <a href="{{ path('app_bookings_edit', {id: booking.id}) }}"
                                           class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50 hover:border-gray-300 transition-colors">
                                            {{ ux_icon('heroicons:pencil-square', {class: 'h-3.5 w-3.5'}) }}{{ 'booking.action.edit'|trans({}, 'admin') }}
                                        </a>
                                        <form method="post" action="{{ path('app_bookings_delete', {id: booking.id}) }}" class="js-confirm-form"
                                              data-confirm="{{ 'booking.delete_confirm'|trans({}, 'admin')|e('html_attr') }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_resource_booking_' ~ booking.id) }}">
                                            <input type="hidden" name="back" value="list">
                                            <button type="submit"
                                                    class="js-confirm-trigger inline-flex items-center gap-1.5 rounded-lg border border-red-200 px-3 py-1.5 text-xs font-medium text-red-600 hover:bg-red-50 hover:border-red-300 transition-colors"
                                                    aria-label="{{ 'booking.action.delete'|trans({}, 'admin') }}">
                                                {{ ux_icon('heroicons:trash', {class: 'h-3.5 w-3.5'}) }}
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
            </div>

            {{ pager.nav(pagination) }}
        {% endif %}
        </div>
    {% endif %}
</div>
