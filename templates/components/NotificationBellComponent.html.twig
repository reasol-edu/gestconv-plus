<div {{ attributes.defaults({class: 'relative'}).defaults(stimulus_controller('dropdown')) }}>

    <button type="button"
            data-action="dropdown#toggle"
            aria-label="{{ 'bell.aria'|trans({}, 'notifications') }}"
            class="relative rounded-lg p-1.5 text-gray-500 hover:bg-gray-100 hover:text-gray-700 transition-colors">
        {{ ux_icon('heroicons:bell', {class: 'h-5 w-5'}) }}
        {% if this.total > 0 %}
            <span class="absolute -top-0.5 -right-0.5 flex h-4 min-w-4 items-center justify-center rounded-full
                         {{ this.hasUrgent ? 'bg-red-600' : 'bg-amber-500' }} px-1 text-[10px] font-semibold leading-none text-white">
                {{ this.total > 99 ? '99+' : this.total }}
            </span>
        {% endif %}
    </button>

    <div data-dropdown-target="menu"
         class="hidden absolute right-0 z-40 mt-2 w-80 origin-top-right rounded-xl border border-gray-200
                bg-white shadow-lg overflow-hidden">

        <div class="border-b border-gray-100 px-4 py-2.5">
            <p class="text-xs font-semibold text-gray-700 uppercase tracking-wide">
                {{ 'bell.title'|trans({}, 'notifications') }}
            </p>
        </div>

        {% if this.total == 0 %}
            <div class="px-4 py-8 text-center">
                {{ ux_icon('heroicons:check-circle', {class: 'mx-auto h-8 w-8 text-green-300 mb-2'}) }}
                <p class="text-sm text-gray-500">{{ 'bell.empty'|trans({}, 'notifications') }}</p>
            </div>
        {% else %}
            <div class="max-h-96 overflow-y-auto">
            {% for section in this.sections %}
            {% set sectionUrgent = section.key == 'prescription' %}
            <section aria-labelledby="bell-section-{{ section.key }}">
            <h3 id="bell-section-{{ section.key }}"
                class="flex items-center justify-between gap-2 px-4 py-1.5 text-[11px] font-semibold uppercase tracking-wide
                       {{ sectionUrgent ? 'bg-red-50 text-red-800' : 'bg-gray-50 text-gray-500' }}">
                <span>{{ ('bell.section.' ~ section.key)|trans({}, 'notifications') }}</span>
                <span class="rounded-full px-1.5 {{ sectionUrgent ? 'bg-red-600 text-white' : 'bg-gray-200 text-gray-600' }}">{{ section.total }}</span>
            </h3>
            <ul class="divide-y divide-gray-100">
                {% for item in section.items %}
                    {% set entity = item.entity %}
                    <li>
                        {% if item.type starts with 'prescription_' %}
                            {% set isReportItem = item.type == 'prescription_report' %}
                            <a href="{{ isReportItem ? path('app_notifications_register_report', {id: entity.id}) : path('app_notifications_register_sanction', {id: entity.id}) }}"
                               class="block px-4 py-2.5 hover:bg-red-50/50 transition-colors">
                                <p class="text-sm text-gray-800">
                                    {{ (isReportItem ? 'bell.item.prescription_report' : 'bell.item.prescription_sanction')|trans({'%student%': entity.student.name.firstName ~ ' ' ~ entity.student.name.lastName}, 'notifications') }}
                                    {% if entity.group is not empty %}<span class="text-xs text-gray-400">({{ entity.group.name }})</span>{% endif %}
                                </p>
                                <p class="mt-0.5 text-xs font-medium text-red-700">{{ 'notification.upcoming.in_days'|trans({'%count%': item.daysLeft}, 'notifications') }}</p>
                            </a>
                        {% elseif item.type == 'note_threshold' %}
                            <a href="{{ path('app_daily_notes_index', {tab: 'students', typeId: entity.typeId}) }}" class="block px-4 py-2.5 hover:bg-gray-50 transition-colors">
                                <p class="text-sm text-gray-800">
                                    {{ 'bell.item.note_threshold'|trans({'%student%': entity.firstName ~ ' ' ~ entity.lastName, '%count%': entity.activeCount, '%type%': entity.typeName}, 'notifications') }}
                                    {% if entity.groupName is not empty %}<span class="text-xs text-gray-400">({{ entity.groupName }})</span>{% endif %}
                                </p>
                                <p class="mt-0.5 text-xs text-gray-400">{{ item.date|date('format.date'|trans) }}</p>
                            </a>
                        {% else %}
                            {% set student = item.type == 'task' ? entity.sanction.student : entity.student %}
                            {% set group = item.type == 'task' ? entity.sanction.group : entity.group %}
                            {% set href = item.type == 'report'
                                    ? path('app_notifications_register_report', {id: entity.id})
                                    : item.type == 'sanction'
                                        ? path('app_notifications_register_sanction', {id: entity.id})
                                        : path('app_sanction_tasks_edit', {id: entity.sanction.id, taskId: entity.id}) %}
                            {% set label = item.type == 'report' ? 'bell.item.report' : item.type == 'sanction' ? 'bell.item.sanction' : 'bell.item.task' %}
                            <a href="{{ href }}" class="block px-4 py-2.5 hover:bg-gray-50 transition-colors">
                                <p class="text-sm text-gray-800">
                                    {{ label|trans({'%student%': student.name.firstName ~ ' ' ~ student.name.lastName}, 'notifications') }}
                                    {% if group is not empty %}<span class="text-xs text-gray-400">({{ group.name }})</span>{% endif %}
                                </p>
                                <p class="mt-0.5 text-xs text-gray-400">{{ item.date|date('format.date'|trans) }}</p>
                            </a>
                        {% endif %}
                    </li>
                {% endfor %}
                {% if section.hidden > 0 %}
                    {% set moreHref = section.key == 'task' ? path('app_sanction_tasks_index') : (section.key == 'note_threshold' ? path('app_daily_notes_index', {tab: 'students'}) : path('app_notifications_index')) %}
                    <li>
                        <a href="{{ moreHref }}" class="block px-4 py-1.5 text-xs font-medium text-forest-700 hover:bg-gray-50 transition-colors">
                            {{ 'bell.more'|trans({'%count%': section.hidden}, 'notifications') }}
                        </a>
                    </li>
                {% endif %}
            </ul>
            </section>
            {% endfor %}
            </div>
            <div class="border-t border-gray-100 px-4 py-2.5">
                <a href="{{ path('app_notifications_index') }}" class="text-xs font-medium text-forest-700 hover:text-forest-800">
                    {{ 'bell.view_all'|trans({}, 'notifications') }}
                </a>
            </div>
        {% endif %}

    </div>
</div>
