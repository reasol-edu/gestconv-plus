{% import 'components/_pagination_live.html.twig' as pager %}
<div {{ attributes }}>
    {% set pagination = this.pagination %}

    <div data-loading="addClass(opacity-50 pointer-events-none animate-pulse)" class="transition-opacity">
        {% if pagination.totalItems == 0 %}
            <div class="px-6 py-10 text-center">
                <p class="text-sm text-gray-400">{{ 'daily_note.student_history_empty'|trans({}, 'admin') }}</p>
            </div>
        {% else %}
            <ul class="divide-y divide-gray-100">
                {% for note in pagination.items %}
                    <li class="flex items-center justify-between gap-3 px-6 py-3 {{ note.ignored ? 'opacity-50' : '' }}">
                        <div class="min-w-0">
                            <p class="text-sm font-medium text-gray-800">
                                <span class="inline-flex items-center rounded-full bg-sky-50 text-sky-700 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide mr-1.5">
                                    {{ note.type.name }}
                                </span>
                                {{ note.occurredAt|date('format.datetime'|trans) }}
                                · {{ note.registeredBy.name.lastName }}, {{ note.registeredBy.name.firstName }}
                                {% if note.ignored %}
                                    <span class="inline-flex items-center rounded-full bg-gray-100 text-gray-500 px-2 py-0.5 text-[11px] font-medium ml-1">
                                        {{ 'daily_note.badge.ignored'|trans({}, 'admin') }}
                                    </span>
                                {% endif %}
                            </p>
                            {% if note.observations %}
                                <p class="mt-0.5 text-xs text-gray-500 truncate">{{ note.observations }}</p>
                            {% endif %}
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            {% if is_granted('daily_note.edit_observations', note) or is_granted('daily_note.manage', note) %}
                                <a href="{{ path('app_daily_notes_edit', {id: note.id}) }}"
                                   class="inline-flex items-center rounded-lg border border-gray-200 px-2.5 py-1 text-xs font-medium text-gray-700 hover:bg-gray-50 transition-colors">
                                    {{ 'ui.edit'|trans }}
                                </a>
                            {% endif %}
                            {% if not note.ignored and is_granted('daily_note.ignore', note) %}
                                <form method="post" action="{{ path('app_daily_notes_ignore_one', {id: note.id}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('ignore_daily_note_' ~ note.id) }}">
                                    <button type="submit"
                                            class="inline-flex items-center rounded-lg border border-gray-200 px-2.5 py-1 text-xs font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                                        {{ 'daily_note.field.ignored'|trans({}, 'admin') }}
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>

            {{ pager.nav(pagination) }}
        {% endif %}
    </div>
</div>
