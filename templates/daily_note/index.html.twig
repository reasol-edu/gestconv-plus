{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'daily_note.title'|trans({}, 'admin') }} · {{ centre.name }} · {{ app_name }}{% endblock %}

{% block content %}
<div class="px-6 py-8 max-w-7xl mx-auto space-y-6">

    <div class="flex items-start justify-between gap-4 flex-wrap">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">{{ 'daily_note.title'|trans({}, 'admin') }}</h1>
            {% set vy = view_year() %}
            {% if vy %}
                <p class="mt-1 text-sm {{ is_viewing_past_year() ? 'text-amber-600 font-medium' : 'text-gray-500' }}">{{ vy.name }}</p>
            {% endif %}
        </div>
        {% if not is_viewing_past_year() %}
            <a href="{{ path('app_daily_notes_new') }}"
               class="inline-flex items-center gap-2 rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white
                      hover:bg-forest-700 transition-colors shadow-xs shrink-0">
                {{ ux_icon('heroicons:plus', {class: 'h-4 w-4'}) }}
                {{ 'daily_note.new'|trans({}, 'admin') }}
            </a>
        {% endif %}
    </div>

    {% if canSeeStudents %}
        {# ── Pestañas ─────────────────────────────────────────────────── #}
        <nav class="flex gap-6 border-b border-gray-200" aria-label="{{ 'daily_note.tabs.notes'|trans({}, 'admin') }}">
            <a href="{{ path('app_daily_notes_index', {tab: 'notes'}) }}"
               {% if tab == 'notes' %}aria-current="page"{% endif %}
               class="-mb-px inline-flex items-center gap-2 border-b-2 px-1 py-3 text-sm font-medium transition-colors
                      {{ tab == 'notes' ? 'border-forest-600 text-forest-700' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }}">
                {{ ux_icon('heroicons:document-text', {class: 'h-4 w-4'}) }}
                {{ 'daily_note.tabs.notes'|trans({}, 'admin') }}
            </a>
            <a href="{{ path('app_daily_notes_index', {tab: 'students'}) }}"
               {% if tab == 'students' %}aria-current="page"{% endif %}
               class="-mb-px inline-flex items-center gap-2 border-b-2 px-1 py-3 text-sm font-medium transition-colors
                      {{ tab == 'students' ? 'border-forest-600 text-forest-700' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' }}">
                {{ ux_icon('heroicons:users', {class: 'h-4 w-4'}) }}
                {{ 'daily_note.tabs.students'|trans({}, 'admin') }}
            </a>
        </nav>
    {% endif %}

    {% if tab == 'students' %}
        <div class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden">
            <twig:DailyNoteStudentListComponent :centre="centre" :viewer="app.user" initialTypeId="{{ typeId }}" />
        </div>
    {% else %}
        <div class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden">
            <twig:DailyNoteListComponent :centre="centre" />
        </div>
    {% endif %}

</div>
{% endblock %}
