{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'daily_note.edit_title'|trans({}, 'admin') }} · {{ app_name }}{% endblock %}

{% block content %}
<div class="px-6 py-8 max-w-2xl mx-auto space-y-6">

    <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 flex-wrap">
            {% include 'components/_breadcrumb_home.html.twig' %}
            <a href="{{ path('app_students_show', {id: note.student.id}) }}" class="hover:text-forest-600 transition-colors">
                {{ note.student.name.lastName }}, {{ note.student.name.firstName }}
            </a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ 'daily_note.edit_title'|trans({}, 'admin') }}</h1>
    </div>

    <div class="rounded-2xl border border-gray-200 bg-white shadow-xs p-6">
        <form method="post" action="{{ path('app_daily_notes_edit', {id: note.id}) }}" class="space-y-5">
            <input type="hidden" name="_token" value="{{ csrf_token('edit_daily_note_' ~ note.id) }}">

            <div class="text-sm text-gray-600">
                <p>
                    <span class="inline-flex items-center rounded-full bg-sky-50 text-sky-700 px-2 py-0.5 text-xs font-semibold uppercase tracking-wide">
                        {{ note.type.name }}
                    </span>
                    <span class="ml-2 text-xs text-gray-400">{{ note.occurredAt|date('format.datetime'|trans) }}</span>
                </p>
                <p class="mt-1">{{ note.registeredBy.name.lastName }}, {{ note.registeredBy.name.firstName }}</p>
            </div>

            <div>
                <label for="observations" class="block text-sm font-medium text-gray-700 mb-1.5">
                    {{ 'daily_note.field.observations'|trans({}, 'admin') }}
                </label>
                <textarea id="observations" name="observations" rows="4"
                          class="block w-full rounded-xl border border-gray-200 bg-gray-50 px-3.5 py-2.5 text-sm text-gray-900
                                 focus:border-forest-500 focus:bg-white focus:outline-none focus:ring-3 focus:ring-forest-500/20 transition-colors">{{ note.observations }}</textarea>
            </div>

            {% if canManage %}
                <div>
                    <p class="block text-sm font-medium text-gray-700 mb-2">{{ 'daily_note.field.status'|trans({}, 'admin') }}</p>
                    <div class="grid grid-cols-2 gap-3">
                        <twig:Form:RadioCard
                            name="active"
                            value="1"
                            label="{{ 'daily_note.badge.active'|trans({}, 'admin') }}"
                            help="{{ 'daily_note.field.active_on'|trans({}, 'admin') }}"
                            :checked="note.active"
                        />
                        <twig:Form:RadioCard
                            name="active"
                            value="0"
                            label="{{ 'daily_note.badge.inactive'|trans({}, 'admin') }}"
                            help="{{ 'daily_note.field.active_off'|trans({}, 'admin') }}"
                            :checked="not note.active"
                            tone="gray"
                        />
                    </div>
                </div>
            {% endif %}

            <div class="flex items-center justify-end gap-3 pt-2">
                <a href="{{ path('app_students_show', {id: note.student.id}) }}"
                   class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-2.5 text-sm font-medium text-gray-700
                          hover:bg-gray-50 transition-colors">
                    {{ 'daily_note.cancel'|trans({}, 'admin') }}
                </a>
                <button type="submit"
                        class="inline-flex items-center gap-2 rounded-xl bg-forest-600 px-4 py-2.5 text-sm font-semibold text-white
                               hover:bg-forest-700 transition-colors shadow-xs">
                    {{ ux_icon('heroicons:check', {class: 'h-4 w-4'}) }}
                    {{ 'daily_note.save'|trans({}, 'admin') }}
                </button>
            </div>
        </form>

        {% if is_granted('daily_note.delete_own', note) or canManage %}
            <form method="post" action="{{ path('app_daily_notes_delete', {id: note.id}) }}"
                  class="js-confirm-form mt-4 pt-4 border-t border-gray-100"
                  data-confirm="{{ 'daily_note.delete_confirm'|trans({}, 'admin')|e('html_attr') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_daily_note_' ~ note.id) }}">
                <button type="submit"
                        class="js-confirm-trigger inline-flex items-center gap-2 rounded-xl border border-red-200 px-4 py-2.5 text-sm font-medium
                               text-red-600 hover:bg-red-50 hover:border-red-300 transition-colors">
                    {{ ux_icon('heroicons:trash', {class: 'h-4 w-4'}) }}
                    {{ 'daily_note.delete'|trans({}, 'admin') }}
                </button>
            </form>
        {% endif %}
    </div>

</div>
{% endblock %}
