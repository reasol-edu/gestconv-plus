{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'exit_stats.title'|trans({}, 'admin') }} · {{ centre.name }} · {{ app_name }}{% endblock %}

{% block content %}
<div class="px-6 py-8 max-w-6xl mx-auto space-y-6">

    <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 flex-wrap">
            {% include 'components/_breadcrumb_home.html.twig' %}
            <a href="{{ path('app_reports_index', {centreId: centre.id}) }}" class="hover:text-forest-600 transition-colors">{{ 'reports'|trans({}, 'navigation') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
            <span aria-current="page" class="text-gray-700 font-medium">{{ 'exit_stats.title'|trans({}, 'admin') }}</span>
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ 'exit_stats.title'|trans({}, 'admin') }}</h1>
        {% if year %}
            <p class="mt-1 text-sm text-gray-500">{{ year.name }}</p>
        {% endif %}
    </div>

    {% if year is null %}
        <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
            {{ 'group_stats.no_active_year'|trans({}, 'admin') }}
        </div>
    {% else %}
        {% include 'reports/_range_form.html.twig' with {prefix: 'exit-stats', hasReport: report is not null, pdfRoute: 'app_reports_exit_stats_pdf', xlsxRoute: 'app_reports_exit_stats_xlsx'} %}

        {% if report %}
            {% set totals = report.totals %}

            {% if totals.exits == 0 %}
                <div class="rounded-xl border border-gray-200 bg-white px-4 py-6 text-center text-sm text-gray-500">
                    {{ 'exit_stats.empty'|trans({}, 'admin') }}
                </div>
            {% else %}
                {# ── Resumen ── #}
                <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
                    {% for tile in [
                        {label: 'exit_stats.summary.exits', value: totals.exits},
                        {label: 'exit_stats.summary.students', value: totals.students},
                        {label: 'exit_stats.summary.groups', value: totals.groups},
                        {label: 'exit_stats.summary.average', value: totals.averageSeconds|report_duration},
                        {label: 'exit_stats.summary.max', value: totals.returned > 0 ? totals.secondsMax|report_duration : '—'},
                        {label: 'exit_stats.summary.not_returned', value: totals.notReturned},
                    ] %}
                        <div class="rounded-2xl border border-gray-200 bg-white px-4 py-3 shadow-xs">
                            <p class="text-xl font-bold text-gray-900">{{ tile.value }}</p>
                            <p class="text-xs text-gray-500">{{ tile.label|trans({}, 'admin') }}</p>
                        </div>
                    {% endfor %}
                </div>

                {# ── Por tipo de salida ── #}
                <section class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden overflow-x-auto">
                    <h2 class="px-4 py-3 text-sm font-semibold text-gray-700 border-b border-gray-100">{{ 'exit_stats.by_reason.title'|trans({}, 'admin') }}</h2>
                    <table class="w-full text-sm">
                        <thead class="bg-gray-50 border-b border-gray-200">
                            <tr class="text-xs font-semibold uppercase tracking-wide text-gray-500">
                                <th scope="col" class="text-left px-4 py-3">{{ 'exit_stats.column.reason'|trans({}, 'admin') }}</th>
                                <th scope="col" class="text-right px-4 py-3">{{ 'exit_stats.column.exits'|trans({}, 'admin') }}</th>
                                <th scope="col" class="text-right px-4 py-3">%</th>
                                <th scope="col" class="text-right px-4 py-3">{{ 'exit_stats.column.students'|trans({}, 'admin') }}</th>
                                <th scope="col" class="text-right px-4 py-3">{{ 'exit_stats.column.groups'|trans({}, 'admin') }}</th>
                                <th scope="col" class="text-right px-4 py-3">{{ 'exit_stats.column.average'|trans({}, 'admin') }}</th>
                                <th scope="col" class="text-right px-4 py-3">{{ 'exit_stats.column.max'|trans({}, 'admin') }}</th>
                                <th scope="col" class="text-right px-4 py-3">{{ 'exit_stats.column.not_returned'|trans({}, 'admin') }}</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            {% for r in report.reasons %}
                                <tr class="[&>td]:px-4 [&>td]:py-2.5">
                                    <td class="font-medium text-gray-900">{{ r.reason.name }}</td>
                                    <td class="text-right">{{ r.totals.exits }}</td>
                                    <td class="text-right text-gray-500">{{ (r.totals.exits * 100 / totals.exits)|round(1) }}</td>
                                    <td class="text-right">{{ r.totals.students }}</td>
                                    <td class="text-right">{{ r.totals.groups }}</td>
                                    <td class="text-right">{{ r.totals.averageSeconds|report_duration }}</td>
                                    <td class="text-right">{{ r.totals.returned > 0 ? r.totals.secondsMax|report_duration : '—' }}</td>
                                    <td class="text-right">{{ r.totals.notReturned }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </section>

                {# ── Detalle de cada tipo: grupos y alumnado que más lo usan ── #}
                <section class="space-y-3">
                    <h2 class="text-sm font-semibold text-gray-700">{{ 'exit_stats.detail.title'|trans({}, 'admin') }}</h2>
                    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
                        {% for r in report.reasons %}
                            <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-xs">
                                <h3 class="text-sm font-semibold text-forest-700">{{ r.reason.name }}
                                    <span class="font-normal text-gray-500">· {{ 'exit_stats.detail.exits'|trans({'%count%': r.totals.exits}, 'admin') }}</span>
                                </h3>
                                <p class="mt-2 text-xs font-semibold uppercase tracking-wide text-gray-500">{{ 'exit_stats.detail.top_groups'|trans({}, 'admin') }}</p>
                                <ul class="mt-1 text-sm text-gray-700 space-y-0.5">
                                    {% for g in r.topGroups %}
                                        <li class="flex justify-between gap-2"><span>{{ g.group.name }}</span><span class="text-gray-500">{{ g.exits }} · {{ 'exit_stats.detail.students'|trans({'%count%': g.students}, 'admin') }}</span></li>
                                    {% endfor %}
                                </ul>
                                <p class="mt-3 text-xs font-semibold uppercase tracking-wide text-gray-500">{{ 'exit_stats.detail.top_students'|trans({}, 'admin') }}</p>
                                <ul class="mt-1 text-sm text-gray-700 space-y-0.5">
                                    {% for s in r.topStudents %}
                                        <li class="flex justify-between gap-2"><span>{{ s.student.name.full }} <span class="text-xs text-gray-400">{{ s.group.name }}</span></span><span class="text-gray-500">{{ s.exits }} · {{ s.seconds|report_duration }}</span></li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endfor %}
                    </div>
                </section>

                {# ── Por grupo y tipo ── #}
                <section class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden overflow-x-auto">
                    <h2 class="px-4 py-3 text-sm font-semibold text-gray-700 border-b border-gray-100">{{ 'exit_stats.by_group.title'|trans({}, 'admin') }}</h2>
                    <table class="w-full text-sm">
                        <thead class="bg-gray-50 border-b border-gray-200">
                            <tr class="text-xs font-semibold uppercase tracking-wide text-gray-500">
                                <th scope="col" class="text-left px-4 py-3">{{ 'exit_stats.column.group'|trans({}, 'admin') }}</th>
                                <th scope="col" class="text-right px-4 py-3">{{ 'exit_stats.column.students'|trans({}, 'admin') }}</th>
                                <th scope="col" class="text-right px-4 py-3">{{ 'exit_stats.column.exits'|trans({}, 'admin') }}</th>
                                {% for r in report.reasons %}
                                    <th scope="col" class="text-right px-4 py-3">{{ r.reason.name }}</th>
                                {% endfor %}
                                <th scope="col" class="text-right px-4 py-3">{{ 'exit_stats.column.average'|trans({}, 'admin') }}</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            {% for course in report.courses %}
                                <tr class="bg-forest-50">
                                    <td colspan="{{ 4 + report.reasons|length }}" class="px-4 py-2 text-xs font-bold uppercase tracking-wide text-forest-700">{{ course.course.name }}</td>
                                </tr>
                                {% for row in course.rows %}
                                    <tr class="[&>td]:px-4 [&>td]:py-2.5">
                                        <td>{{ row.group.name }}</td>
                                        <td class="text-right">{{ row.totals.students }}</td>
                                        <td class="text-right">{{ row.totals.exits }}</td>
                                        {% for r in report.reasons %}
                                            <td class="text-right">{{ row.byReason[r.reason.id.toRfc4122] ?? 0 }}</td>
                                        {% endfor %}
                                        <td class="text-right">{{ row.totals.averageSeconds|report_duration }}</td>
                                    </tr>
                                {% endfor %}
                                <tr class="[&>td]:px-4 [&>td]:py-2.5 font-semibold bg-gray-50 border-t border-gray-200">
                                    <td>{{ 'group_stats.subtotal'|trans({}, 'admin') }}</td>
                                    <td class="text-right">{{ course.total.totals.students }}</td>
                                    <td class="text-right">{{ course.total.totals.exits }}</td>
                                    {% for r in report.reasons %}
                                        <td class="text-right">{{ course.total.byReason[r.reason.id.toRfc4122] ?? 0 }}</td>
                                    {% endfor %}
                                    <td class="text-right">{{ course.total.totals.averageSeconds|report_duration }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </section>

                {# ── Alumnado con más salidas ── #}
                <section class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden overflow-x-auto">
                    <h2 class="px-4 py-3 text-sm font-semibold text-gray-700 border-b border-gray-100">{{ 'exit_stats.top_students.title'|trans({'%count%': report.topStudents|length}, 'admin') }}</h2>
                    <table class="w-full text-sm">
                        <thead class="bg-gray-50 border-b border-gray-200">
                            <tr class="text-xs font-semibold uppercase tracking-wide text-gray-500">
                                <th scope="col" class="text-left px-4 py-3">{{ 'exit_stats.column.student'|trans({}, 'admin') }}</th>
                                <th scope="col" class="text-left px-4 py-3">{{ 'exit_stats.column.group'|trans({}, 'admin') }}</th>
                                <th scope="col" class="text-right px-4 py-3">{{ 'exit_stats.column.exits'|trans({}, 'admin') }}</th>
                                <th scope="col" class="text-right px-4 py-3">{{ 'exit_stats.column.total_time'|trans({}, 'admin') }}</th>
                                <th scope="col" class="text-left px-4 py-3">{{ 'exit_stats.column.top_reason'|trans({}, 'admin') }}</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100">
                            {% for s in report.topStudents %}
                                <tr class="[&>td]:px-4 [&>td]:py-2.5">
                                    <td class="font-medium text-gray-900">{{ s.student.name.full }}</td>
                                    <td>{{ s.group.name }}</td>
                                    <td class="text-right">{{ s.exits }}</td>
                                    <td class="text-right">{{ s.seconds|report_duration }}</td>
                                    <td>{{ s.topReason ? s.topReason.name : '' }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </section>

                <p class="text-xs text-gray-500">{{ 'exit_stats.legend'|trans({}, 'admin') }}</p>
            {% endif %}
        {% endif %}
    {% endif %}

</div>
{% endblock %}
