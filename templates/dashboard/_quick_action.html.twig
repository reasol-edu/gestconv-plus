{#
   Tarjeta de acceso rápido del inicio. Parámetros:
   - url:   destino; null/vacío = tarjeta desactivada (no hay nada que hacer ahora)
   - icon, label, help
   - tone:  primary (botón destacado) | forest | blue | amber | red
   - badge: número que se muestra sobre el icono (0 = sin distintivo)

   Pensada para el móvil y para el ordenador: en pantallas pequeñas es una baldosa compacta (icono y
   título, dos por fila) y a partir de «sm» una tarjeta ancha con su texto de ayuda. Las clases se escriben
   completas porque Tailwind solo genera las que encuentra literalmente.
#}
{% set badge = badge|default(0) %}
{% if url %}
    <a href="{{ url }}"
       class="flex min-h-[5.5rem] flex-col items-start justify-between gap-2 rounded-2xl px-3.5 py-3.5 shadow-xs transition sm:min-h-0 sm:flex-row sm:items-center sm:justify-start sm:gap-3 sm:px-5 sm:py-5
              {{ tone == 'primary' ? 'bg-forest-600 text-white hover:bg-forest-700 active:bg-forest-800' : 'border border-gray-200 bg-white hover:border-forest-300 hover:shadow-sm active:bg-gray-50' }}">
        <span class="relative flex h-10 w-10 shrink-0 items-center justify-center rounded-xl sm:h-12 sm:w-12
                     {{ tone == 'primary' ? 'bg-white/15' : (tone == 'blue' ? 'bg-blue-50 text-blue-600' : (tone == 'amber' ? 'bg-amber-50 text-amber-600' : (tone == 'red' ? 'bg-red-50 text-red-500' : 'bg-forest-50 text-forest-600'))) }}">
            {{ ux_icon(icon, {class: 'h-5 w-5 sm:h-6 sm:w-6'}) }}
            {% if badge > 0 %}
                <span class="absolute -right-2 -top-2 flex h-6 min-w-6 items-center justify-center rounded-full bg-red-600 px-1.5 text-xs font-bold text-white shadow-xs">{{ badge }}</span>
            {% endif %}
        </span>
        <span class="min-w-0">
            <span class="block text-sm font-semibold leading-snug sm:text-base {{ tone == 'primary' ? '' : 'text-gray-900' }}">{{ label }}</span>
            <span class="hidden truncate text-xs sm:block {{ tone == 'primary' ? 'text-forest-50/90' : 'text-gray-500' }}">{{ help }}</span>
        </span>
    </a>
{% else %}
    <div class="flex min-h-[5.5rem] flex-col items-start justify-between gap-2 rounded-2xl border border-gray-200 bg-gray-50 px-3.5 py-3.5 opacity-60 sm:min-h-0 sm:flex-row sm:items-center sm:justify-start sm:gap-3 sm:px-5 sm:py-5"
         aria-disabled="true">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gray-200 text-gray-400 sm:h-12 sm:w-12">
            {{ ux_icon(icon, {class: 'h-5 w-5 sm:h-6 sm:w-6'}) }}
        </span>
        <span class="min-w-0">
            <span class="block text-sm font-semibold leading-snug text-gray-500 sm:text-base">{{ label }}</span>
            <span class="block text-xs leading-snug text-gray-400 sm:truncate">{{ help }}</span>
        </span>
    </div>
{% endif %}
