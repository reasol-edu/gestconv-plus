{# Pantalla «Próximos días» del tablón: las siguientes jornadas lectivas, con sanciones, ausencias y actividades. #}
{% set showAbsences = feature_enabled('absences') %}
{% set showEvents   = feature_enabled('events') %}

{% if days is empty %}
    <p class="p-8 text-center text-sm text-gray-400 dark:text-forest-400">{{ 'board_upcoming_none'|trans({}, 'calendar') }}</p>
{% else %}
    <div class="flex-1 min-h-0 grid divide-x divide-gray-200 dark:divide-white/10 overflow-hidden"
         style="grid-template-columns: repeat({{ days|length }}, minmax(0, 1fr));">
        {% for entry in days %}
            <div class="flex min-h-0 flex-col overflow-hidden">
                <h3 class="shrink-0 bg-forest-700 px-4 py-2.5 text-sm font-semibold text-white dark:bg-forest-800">
                    {{ ('weekday.' ~ entry.day.format('N'))|trans({}, 'calendar') }}
                    {{ entry.day.format('j') }} {{ 'de'|trans({}, 'calendar') }}
                    {{ ('month.' ~ entry.day.format('n'))|trans({}, 'calendar')|lower }}
                </h3>

                <div class="flex-1 min-h-0 overflow-hidden px-4 pb-4" data-controller="board-column">
                    <h4 class="mt-3 mb-1 text-[11px] font-semibold uppercase tracking-wide text-gray-500 dark:text-forest-300">{{ 'board_upcoming_sanctions'|trans({}, 'calendar') }}</h4>
                    {% if entry.groups is empty %}
                        <p class="text-xs text-gray-400 dark:text-forest-400">{{ 'board_no_sanctions'|trans({}, 'calendar') }}</p>
                    {% else %}
                        <div class="space-y-3">
                            {% for group in entry.groups %}
                                <div>
                                    <p class="mb-1 inline-flex items-center gap-1.5 rounded-full border px-2 py-0.5 text-xs font-semibold" style="{{ group.color.style }}">{{ group.name }}</p>
                                    <ul class="space-y-1.5 pl-1 text-sm">
                                        {% for item in group.items %}
                                            <li>
                                                <span class="font-medium">{{ item.student }}</span>
                                                {% if item.details %}<span class="text-gray-500 dark:text-forest-300"> — {{ item.details }}</span>{% endif %}
                                                <span class="block text-xs text-gray-400 dark:text-forest-400">
                                                    {{ 'board_start_date'|trans({}, 'calendar') }}: {{ item.from|date('format.date'|trans) }}
                                                    · {{ 'board_end_date'|trans({}, 'calendar') }}: {{ (item.to ?? item.from)|date('format.date'|trans) }}
                                                </span>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}

                    {% if showAbsences %}
                        <h4 class="mt-4 mb-1 text-[11px] font-semibold uppercase tracking-wide text-gray-500 dark:text-forest-300">{{ 'board_upcoming_absences'|trans({}, 'calendar') }}</h4>
                        {% if entry.absentTeachers is empty %}
                            <p class="text-xs text-gray-400 dark:text-forest-400">{{ 'board_today_no_absences'|trans({}, 'calendar') }}</p>
                        {% else %}
                            <ul class="space-y-0.5 text-sm">
                                {% for teacher in entry.absentTeachers %}<li>{{ teacher.name.full() }}</li>{% endfor %}
                            </ul>
                        {% endif %}
                    {% endif %}

                    {% if showEvents %}
                        <h4 class="mt-4 mb-1 text-[11px] font-semibold uppercase tracking-wide text-gray-500 dark:text-forest-300">{{ 'board_upcoming_activities'|trans({}, 'calendar') }}</h4>
                        {% if entry.events is empty %}
                            <p class="text-xs text-gray-400 dark:text-forest-400">{{ 'board_activities_none_day'|trans({}, 'calendar') }}</p>
                        {% else %}
                            <ul class="space-y-2.5">
                                {% for event in entry.events %}
                                    <li class="text-sm">
                                        <twig:EventTypeBadge :type="event.type" />
                                        <span class="font-semibold">{{ event.name }}</span>
                                        <span class="text-xs tabular-nums text-gray-500 dark:text-forest-300">{{ event.startTime|date('format.time'|trans) }}–{{ event.endTime|date('format.time'|trans) }}</span>
                                        {% include 'components/_event_meta.html.twig' with {event: event, class: 'mt-0.5', compact: true} only %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
